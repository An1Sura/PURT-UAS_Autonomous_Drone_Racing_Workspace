diff --git a/src/main/drivers/fastdyn_adr.c b/src/main/drivers/fastdyn_adr.c
new file mode 100644
index 0000000..5259980
--- /dev/null
+++ b/src/main/drivers/fastdyn_adr.c
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+ * Deterministic ARM BIL transport. Simulated IO, not hardware latency testing.
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <math.h>
+#include "platform.h"
+#include "drivers/fastdyn_adr.h"
+#include "drivers/time.h"
+#include "drivers/system.h"
+#include "config/feature.h"
+#include "config/config.h"
+#include "cli/cli.h"
+#include "fc/runtime_config.h"
+#include "flight/imu.h"
+#include "sensors/acceleration.h"
+#include "rx/rx.h"
+#include "rx/msp.h"
+#include "scheduler/scheduler.h"
+
+typedef struct { double values[18]; uint32_t sequence, freshRc; uint16_t channels[16]; } AdrInput;
+typedef struct { uint32_t version,sequence; float motors[4]; uint32_t armed,armingFlags,angle; float rpy[3]; uint64_t timeUs; uint32_t motorUpdates,reserved; } AdrOutput;
+typedef struct { uint32_t magic,stage,request,response,terminate,reserved[3]; AdrInput input; AdrOutput output; char config[4096]; char log[512]; } AdrShared;
+_Static_assert(sizeof(AdrInput)==184,"input ABI");
+_Static_assert(sizeof(AdrOutput)==64,"output ABI");
+_Static_assert(__builtin_offsetof(AdrShared,config)==280,"config ABI");
+volatile AdrShared adr_fastdyn_shared __attribute__((aligned(64),used));
+bool adrFastdynActive;
+uint32_t adrFastdynTimeUs, adrFastdynCycles;
+static AdrInput current;
+static float motors[4];
+static uint32_t updates;
+
+void adrFastdynConfigure(void)
+{
+    adr_fastdyn_shared.magic=0x42464431;
+    __DMB(); adr_fastdyn_shared.stage=1;
+    while(adr_fastdyn_shared.stage!=2) { __NOP(); }
+    char line[160]; unsigned n=0;
+    for(unsigned i=0;i<sizeof(adr_fastdyn_shared.config);i++) {
+        char c=adr_fastdyn_shared.config[i];
+        if(c=='\n' || c==0) {
+            line[n]=0;
+            if(n) {
+                char result[512]={0};
+                int len=cliExecuteCommand(line,result,sizeof(result)-1);
+                if(len<0 || strstr(result,"ERROR") || strstr(result,"INVALID") || strstr(result,"Unknown command")) {
+                    memcpy((void *)adr_fastdyn_shared.log,result,sizeof(result));
+                    __DMB(); adr_fastdyn_shared.stage=255;
+                    for(;;) { __NOP(); }
+                }
+            }
+            n=0; if(c==0) break;
+        } else if(n+1<sizeof(line)) line[n++]=c;
+        else { adr_fastdyn_shared.stage=254; for(;;) { __NOP(); } }
+    }
+    writeEEPROM();
+    if (!readEEPROM()) { adr_fastdyn_shared.stage=252; for(;;) { __NOP(); } }
+}
+static int16_t sensor(double v) { return (int16_t)fmax(-32767.0,fmin(32767.0,v)); }
+void adrFastdynGyro(int16_t *d)
+{
+    /* Undo this board's CW180 mounting; gyro processing applies it again. */
+    d[0]=sensor(-current.values[1]*16.4*180.0/M_PI);
+    d[1]=sensor(current.values[2]*16.4*180.0/M_PI);
+    d[2]=sensor(current.values[3]*16.4*180.0/M_PI);
+}
+void adrFastdynAcc(int16_t *d)
+{
+    d[0]=sensor(current.values[4]*2048.0/9.80665);
+    d[1]=sensor(current.values[5]*2048.0/9.80665);
+    d[2]=sensor(-current.values[6]*2048.0/9.80665);
+}
+void adrFastdynMotors(const float *values)
+{
+    for(unsigned i=0;i<4;i++) motors[i]=fmaxf(0,fminf(1,(values[i]-1000.0f)/1000.0f));
+    updates++;
+}
+void adrFastdynRun(void)
+{
+    uint32_t boot=micros(), bootCycles=getCycleCounter(), last=0;
+    adrFastdynCycles=bootCycles;
+    adrFastdynTimeUs=boot;
+    adrFastdynActive=true;
+    accStartCalibration();
+    /* Runtime IO and time are host-driven. No physical interrupts are benchmarked. */
+    __disable_irq();
+    __DMB(); adr_fastdyn_shared.stage=3;
+    for(;;) {
+        while(adr_fastdyn_shared.request==last && !adr_fastdyn_shared.terminate) { __NOP(); }
+        if(adr_fastdyn_shared.terminate) { for(unsigned i=0;i<4;i++) adr_fastdyn_shared.output.motors[i]=0; adr_fastdyn_shared.stage=4; for(;;) { __NOP(); } }
+        __DMB(); memcpy(&current,(const void *)&adr_fastdyn_shared.input,sizeof(current));
+        uint32_t seq=adr_fastdyn_shared.request;
+        if(seq!=last+1 || current.sequence!=seq || !isfinite(current.values[0]) || llround(current.values[0]*1e6)!=(int64_t)seq*125) {
+            adr_fastdyn_shared.stage=253; for(;;) { __NOP(); }
+        }
+        adrFastdynTimeUs=boot+seq*125;
+        adrFastdynCycles=bootCycles+clockMicrosToCycles(seq*125);
+        if(current.freshRc) rxMspFrameReceive(current.channels,16);
+        for(unsigned i=0;i<128;i++) scheduler();
+        AdrOutput out={.version=1,.sequence=seq,.armed=ARMING_FLAG(ARMED),.armingFlags=getArmingDisableFlags(),.angle=FLIGHT_MODE(ANGLE_MODE),.timeUs=(uint64_t)seq*125,.motorUpdates=updates};
+        memcpy(out.motors,motors,sizeof(motors));
+        for(unsigned i=0;i<3;i++) out.rpy[i]=attitude.raw[i]*0.1f;
+        memcpy((void *)&adr_fastdyn_shared.output,&out,sizeof(out));
+        __DMB(); adr_fastdyn_shared.response=seq; last=seq;
+    }
+}
