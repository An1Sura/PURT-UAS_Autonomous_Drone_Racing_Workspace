+// Offsets verified from DWARF in the pinned ArduCopter 4.6.2 ELF.
+// Replace driver discovery only. Keep AP_Baro::calibrate/update/arming_checks.
+void adr_baro_init(unsigned int cpu_index, void *udata)
+{
+    (void)cpu_index; (void)udata;
+    uint32_t object = (uint32_t)qemu_get_register(ARM_V7M_R0);
+    uint8_t one = 1;
+    qemu_plugin_write_memory(object + 16, &one, 1); // _num_sensors
+    qemu_plugin_write_memory(object + 24, &one, 1); // init_done
+    qemu_set_register(qemu_get_register(ARM_V7M_LR), ARM_V7M_PC);
+}
+// Entry hook: supply raw sensor fields, then execute the original frontend.
+void adr_baro_sample(unsigned int cpu_index, void *udata)
+{
+    (void)cpu_index; (void)udata;
+    uint32_t object = (uint32_t)qemu_get_register(ARM_V7M_R0);
+    double pressure, temperature;
+    uint8_t healthy = fmu_get_baro_sample(&pressure, &temperature);
+    qemu_plugin_write_memory(object + 28 + 29, &healthy, 1);
+    if (!healthy) return;
+    float p = pressure, t = temperature;
+    uint32_t timestamp_ms = (uint32_t)(qemu_plugin_get_virtual_timer() / 1000000);
+    qemu_plugin_write_memory(object + 28, (uint8_t *)&timestamp_ms, 4);
+    qemu_plugin_write_memory(object + 32, (uint8_t *)&timestamp_ms, 4);
+    qemu_plugin_write_memory(object + 36, (uint8_t *)&p, 4);
+    qemu_plugin_write_memory(object + 40, (uint8_t *)&t, 4);
+}
+#endif
