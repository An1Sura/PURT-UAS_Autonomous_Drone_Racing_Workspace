+def calibrate_sim_sensors(mav):
+    # This is a stationary, level simulation fixture with ENU yaw zero (east).
+    # Use public firmware calibration commands, never the force-valid code 76.
+    for command, params in [
+        (mavutil.mavlink.MAV_CMD_PREFLIGHT_CALIBRATION, [0, 0, 0, 0, 4, 0, 0]),
+        (mavutil.mavlink.MAV_CMD_FIXED_MAG_CAL_YAW, [90, 0, 0, 0, 0, 0, 0]),
+    ]:
+        print(f"[mission] normal simulated-sensor calibration command={command}", flush=True)
+        mav.mav.command_long_send(mav.target_system, mav.target_component, command, 0, *params)
+        deadline = time.monotonic() + 60
+        while time.monotonic() < deadline:
+            msg = mav.recv_match(blocking=True, timeout=0.1)
+            if msg is None:
+                continue
+            handle_runtime_message(mav, msg)
+            if msg.get_type() == "COMMAND_ACK" and msg.command == command:
+                if msg.result == mavutil.mavlink.MAV_RESULT_ACCEPTED:
+                    print(f"[mission] calibration accepted command={command}", flush=True)
+                    break
+                if msg.result != mavutil.mavlink.MAV_RESULT_IN_PROGRESS:
+                    raise RuntimeError(f"calibration rejected: {command}, result={msg.result}")
+        else:
+            raise TimeoutError(f"calibration timed out: {command}")
 
 
