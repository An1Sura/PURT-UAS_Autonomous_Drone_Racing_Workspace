+// Entry hook: supply raw sensor fields, then execute the original frontend.
+void adr_baro_sample(unsigned int cpu_index, void *udata)
+{
+    (void)cpu_index; (void)udata;
+    uint32_t object = (uint32_t)qemu_get_register(ARM_V7M_R0);
