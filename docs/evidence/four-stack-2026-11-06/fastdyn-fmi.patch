diff --git a/src/fastdyn/fmu_build.py b/src/fastdyn/fmu_build.py
index 62660e1..9c67cc7 100644
--- a/src/fastdyn/fmu_build.py
+++ b/src/fastdyn/fmu_build.py
@@ -4,6 +4,7 @@ from __future__ import annotations
 
 from dataclasses import dataclass
 import os
+import platform
 from pathlib import Path
 import shutil
 import subprocess
@@ -440,6 +441,25 @@ def _model_description_xml(build: FmuBuild) -> bytes:
     )
 
 
+def runtime_metadata(build: FmuBuild) -> tuple[str, str]:
+    """Resolve the FMI token and host binary from the FMU's own metadata."""
+    root = ET.fromstring(_model_description_xml(build))
+    token = root.attrib.get("instantiationToken", "")
+    cs = root.find("CoSimulation")
+    identifier = cs.attrib.get("modelIdentifier", "") if cs is not None else ""
+    if not token or any(c in token for c in ",=\n\r"):
+        raise FmuConfigError("Missing or unsafe FMI instantiationToken")
+    if not identifier or Path(identifier).name != identifier:
+        raise FmuConfigError("Missing or unsafe CoSimulation modelIdentifier")
+    host = {"aarch64": "aarch64-linux", "x86_64": "x86_64-linux"}.get(platform.machine())
+    if platform.system() != "Linux" or host is None:
+        raise FmuConfigError("This native FastDyn FMU loader requires a supported Linux host")
+    library = build.output / "binaries" / host / (identifier + ".so")
+    if not library.is_file():
+        raise FmuConfigError(f"Build the FMU host library first: {library}")
+    return str(library.resolve()), token
+
+
 def value_references(build: FmuBuild) -> dict[str, int]:
     """Read named FMI value references from the generated modelDescription.xml."""
 
