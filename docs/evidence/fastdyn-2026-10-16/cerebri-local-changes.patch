+
+/// Resolve the generated host library from the FMI description, not its random filename.
+pub fn host_paths(directory: &Path) -> Result<(std::path::PathBuf, std::path::PathBuf)> {
+    if std::env::consts::OS != "linux" {
+        bail!("native FMI host discovery currently supports Linux");
+    }
+    let description = directory.join("modelDescription.xml");
+    let xml = fs::read_to_string(&description)?;
+    let doc = roxmltree::Document::parse(&xml)?;
+    let id = doc
+        .descendants()
+        .find(|n| n.has_tag_name("CoSimulation"))
+        .and_then(|n| n.attribute("modelIdentifier"))
+        .context("missing FMI model identifier")?;
+    if id.is_empty() || !id.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+        bail!("invalid FMI model identifier");
+    }
+    Ok((
+        directory
+            .join("binaries")
+            .join(format!("{}-linux", std::env::consts::ARCH))
+            .join(format!("{id}.so"))
+            .canonicalize()?,
+        description.canonicalize()?,
+    ))
+}
+
+pub fn file_sha256(path: &std::path::Path) -> Result<String> {
+    let output = std::process::Command::new("sha256sum")
+        .arg(path)
+        .output()
+        .context("sha256sum is required for probe provenance")?;
+    if !output.status.success() {
+        bail!("cannot hash {}", path.display());
+    }
+    let value = String::from_utf8(output.stdout)?
+        .split_whitespace()
+        .next()
+        .context("missing hash")?
+        .to_owned();
+    if value.len() != 64 || !value.chars().all(|x| x.is_ascii_hexdigit()) {
+        bail!("invalid SHA-256 output");
+    }
+    Ok(value)
+}
