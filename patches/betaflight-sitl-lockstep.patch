+#ifdef ADR_LOCKSTEP
+// Version 1, little-endian native ABI; checked sizes are part of the Rust adapter contract.
+typedef struct { fdm_packet sensors; uint32_t sequence; uint32_t freshRc; uint16_t channels[16]; } adr_input;
+typedef struct { uint32_t version,sequence; float motors[4]; uint32_t armed,armingFlags,angle; float rpy[3]; uint64_t timeUs; uint32_t motorUpdates,reserved; } adr_output;
+_Static_assert(sizeof(adr_input)==184,"ADR input layout");
+_Static_assert(sizeof(adr_output)==64,"ADR output layout");
+void simulatorLockstepRun(void) {
+    adr_input input;
+    uint32_t lastSequence=0;
+    uint64_t lastUs=0,bootUs=adrClockUs;
+    adrRunning=true;
+    printf("ADR_LOCKSTEP_READY\n"); fflush(stdout);
+    while (workerRunning) {
+        int n=udpRecv(&stateLink,&input,sizeof(input),100);
+        if(n<0) continue;
+        if(n!=sizeof(input) || input.sequence!=lastSequence+1 || !isfinite(input.sensors.timestamp)) {
+            fprintf(stderr,"ADR invalid packet or sequence\n"); exit(2);
+        }
+        uint64_t us=(uint64_t)llround(input.sensors.timestamp*1e6);
+        if(us!=lastUs+125) { fprintf(stderr,"ADR requires 8000 Hz sensor ticks\n"); exit(2); }
+        adrClockUs=bootUs+us;
+        if(input.freshRc) rxUpdateUdpChannels(input.channels,16);
+        updateState(&input.sensors);
+        // Freeze time while draining ready tasks; the host's execution speed cannot advance the plant.
+        for(unsigned i=0;i<128;++i) scheduler();
+        adr_output output={.version=1,.sequence=input.sequence,.armed=ARMING_FLAG(ARMED),
+            .armingFlags=getArmingDisableFlags(),.angle=FLIGHT_MODE(ANGLE_MODE),.timeUs=us,.motorUpdates=adrMotorUpdates};
+        memcpy(output.motors,pwmPkt.motor_speed,sizeof output.motors);
+        for(unsigned i=0;i<3;++i) output.rpy[i]=attitude.raw[i]*0.1f;
+        udpSend(&pwmLink,&output,sizeof output);
+        lastSequence=input.sequence;lastUs=us;
+    }
+}
+#endif
