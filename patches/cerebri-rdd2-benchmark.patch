@@ -0,0 +1,91 @@
+//! Stack-independent diagnostic reference; not the legacy RDD2 qualification.
+use serde::Serialize;
+#[derive(Clone, Copy, Debug, Serialize)]
+pub struct Reference {
+    pub position_enu_m: [f64; 3],
+    pub velocity_enu_m_s: [f64; 3],
+    pub yaw_enu_rad: f64,
+}
+pub const ID: &str = "enu-square-diagnostic-v1";
+/// Four 5-second, minimum-jerk edges, followed by a hold. Time is mission-relative.
+pub fn sample(time_s: f64) -> Reference {
+    let corners = [
+        [0., 0., 1.5],
+        [0.5, 0., 1.5],
+        [0.5, 0.5, 1.5],
+        [0., 0.5, 1.5],
+        [0., 0., 1.5],
+    ];
+    assert!(time_s.is_finite());
+    let t = time_s.clamp(0., 20.);
+    let edge = ((t / 5.).floor() as usize).min(3);
+    let u = (t - edge as f64 * 5.) / 5.;
+    let s = u * u * u * (10. + u * (-15. + 6. * u));
+    let ds = 30. * u * u * (1. - u) * (1. - u) / 5.;
+    Reference {
+        position_enu_m: std::array::from_fn(|i| {
+            corners[edge][i] + s * (corners[edge + 1][i] - corners[edge][i])
+        }),
+        velocity_enu_m_s: std::array::from_fn(|i| ds * (corners[edge + 1][i] - corners[edge][i])),
+        yaw_enu_rad: 0.,
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn corners_hold_and_derivative() {
+        for (t, p) in [
+            (0., [0., 0., 1.5]),
+            (5., [0.5, 0., 1.5]),
+            (10., [0.5, 0.5, 1.5]),
+            (15., [0., 0.5, 1.5]),
+            (20., [0., 0., 1.5]),
+            (99., [0., 0., 1.5]),
+        ] {
+            assert_eq!(sample(t).position_enu_m, p);
+            assert_eq!(sample(t).velocity_enu_m_s, [0.; 3]);
+        }
+        let t = 2.1;
+        let h = 1e-5;
+        let derivative =
+            (sample(t + h).position_enu_m[0] - sample(t - h).position_enu_m[0]) / (2. * h);
+        assert!((derivative - sample(t).velocity_enu_m_s[0]).abs() < 1e-9);
+    }
+}
+
+/// One Gerono figure eight over 20 seconds, with minimum-jerk phase so
+/// position, velocity and acceleration join the endpoint holds smoothly.
+/// Extents: +/- 1 m east, +/- 0.5 m north; altitude: 1.5 m.
+pub fn figure_eight(time_s: f64) -> Reference {
+    assert!(time_s.is_finite());
+    let u = time_s.clamp(0., 20.) / 20.;
+    let phase = std::f64::consts::TAU * u.powi(3) * (10. + u * (-15. + 6. * u));
+    let rate = std::f64::consts::TAU * 30. * u * u * (1. - u) * (1. - u) / 20.;
+    Reference {
+        position_enu_m: [phase.sin(), phase.sin() * phase.cos(), 1.5],
+        velocity_enu_m_s: [phase.cos() * rate, (2. * phase).cos() * rate, 0.],
+        yaw_enu_rad: 0.,
+    }
+}
+#[cfg(test)]
+mod figure_eight_tests {
+    use super::*;
+    #[test]
+    fn closed_smooth_and_correct_derivative() {
+        for t in [-1., 0., 20., 25.] {
+            let r = figure_eight(t);
+            assert!(r.position_enu_m[0].abs() < 1e-12 && r.position_enu_m[1].abs() < 1e-12);
+            assert_eq!(r.velocity_enu_m_s, [0.; 3]);
+        }
+        for t in [1., 5., 9., 15., 19.] {
+            let h = 1e-5;
+            for i in 0..3 {
+                let d = (figure_eight(t + h).position_enu_m[i]
+                    - figure_eight(t - h).position_enu_m[i])
+                    / (2. * h);
+                assert!((d - figure_eight(t).velocity_enu_m_s[i]).abs() < 1e-8);
+            }
+        }
+    }
+}
