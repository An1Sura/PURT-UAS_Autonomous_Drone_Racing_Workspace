index 0000000..8a5a2be
--- /dev/null
+++ b/xtask/src/betaflight_probe.rs
@@ -0,0 +1,600 @@
+//! Real Betaflight SITL connected to the common FMI plant. Native HOLD/FIGURE8
+//! is an integration diagnostic: its phase law differs from the timed reference.
+use crate::physics::{self, Plant};
+use anyhow::{Result, bail};
+use serde_json::json;
+use std::{
+    collections::VecDeque,
+    fs::{self, File},
+    io::{BufWriter, Read, Write},
+    net::{TcpStream, UdpSocket},
+    path::PathBuf,
+    process::{Command, Stdio},
+    sync::{
+        Arc, Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+    thread,
+    time::{Duration, Instant},
+};
+
+// Trailing altitude/actuator diagnostics, not a timed trajectory score.
+#[derive(Clone, Copy)]
+struct FlightSample {
+    time: f64,
+    altitude: f64,
+    motors: [f32; 4],
+}
+#[derive(Clone, Copy, Default)]
+struct GroundState {
+    altitude: f64,
+    vertical_speed: f64,
+    settled_samples: u64,
+}
+fn grounded(altitude: f64, vertical_speed: f64, motors: [f32; 4]) -> bool {
+    (0.05..=0.20).contains(&altitude)
+        && vertical_speed.abs() <= 0.10
+        && motors.iter().all(|m| *m <= 0.001)
+}
+fn tail_metrics(samples: &VecDeque<FlightSample>) -> serde_json::Value {
+    if samples.is_empty() {
+        return serde_json::Value::Null;
+    }
+    let n = samples.len() as f64;
+    let rmse = (samples
+        .iter()
+        .map(|s| (s.altitude - 1.5).powi(2))
+        .sum::<f64>()
+        / n)
+        .sqrt();
+    let min = samples
+        .iter()
+        .map(|s| s.altitude)
+        .fold(f64::INFINITY, f64::min);
+    let max = samples
+        .iter()
+        .map(|s| s.altitude)
+        .fold(f64::NEG_INFINITY, f64::max);
+    let spread = samples
+        .iter()
+        .map(|s| {
+            let lo = s.motors.iter().copied().fold(f32::INFINITY, f32::min);
+            let hi = s.motors.iter().copied().fold(f32::NEG_INFINITY, f32::max);
+            f64::from(hi - lo)
+        })
+        .sum::<f64>()
+        / n;
+    let limited = samples
+        .iter()
+        .filter(|s| s.motors.iter().any(|m| *m <= 0.01 || *m >= 0.99))
+        .count();
+    json!({"window_start_s":samples.front().unwrap().time,
+        "window_end_s":samples.back().unwrap().time,"samples":samples.len(),
+        "altitude_target_m":1.5,"altitude_rmse_m":rmse,
+        "altitude_min_m":min,"altitude_max_m":max,
+        "mean_motor_spread_normalized":spread,
+        "fraction_samples_any_motor_within_1pct_of_limit":limited as f64/n})
+}
+
+fn request(s: &mut TcpStream, cmd: u8) -> Result<Vec<u8>> {
+    s.write_all(&[b'$', b'M', b'<', 0, cmd, cmd])?;
+    let deadline = Instant::now() + Duration::from_secs(3);
+    let mut prefix = Vec::new();
+    while Instant::now() < deadline {
+        let mut b = [0];
+        s.read_exact(&mut b)?;
+        prefix.push(b[0]);
+        if prefix.ends_with(b"$M!") {
+            bail!("MSP rejected command {cmd}");
+        }
+        if prefix.ends_with(b"$M>") {
+            let mut h = [0; 2];
+            s.read_exact(&mut h)?;
+            let mut data = vec![0; h[0] as usize + 1];
+            s.read_exact(&mut data)?;
+            let checksum = data[..data.len() - 1]
+                .iter()
+                .fold(h[0] ^ h[1], |v, b| v ^ b);
+            if checksum != data[data.len() - 1] {
+                bail!("MSP checksum mismatch");
+            }
+            data.pop();
+            if h[1] == cmd {
+                return Ok(data);
+            }
+            prefix.clear();
+        }
+    }
+    bail!("MSP timeout")
+}
+fn status(s: &mut TcpStream, boxes: &[u8]) -> Result<(u32, Vec<u8>)> {
+    let p = request(s, 101)?;
+    if p.len() < 21 {
+        bail!("short MSP status");
+    }
+    let n = p[15] as usize;
+    if p.len() < 21 + n {
+        bail!("short MSP extended status");
+    }
+    let flags = u32::from_le_bytes(p[17 + n..21 + n].try_into()?);
+    let bits: Vec<u8> = p[6..10]
+        .iter()
+        .chain(p[16..16 + n].iter())
+        .copied()
+        .collect();
+    let modes = boxes
+        .iter()
+        .enumerate()
+        .filter(|(i, _)| *i / 8 < bits.len() && bits[*i / 8] & (1 << (*i % 8)) != 0)
+        .map(|(_, id)| *id)
+        .collect();
+    Ok((flags, modes))
+}
+fn wait_status(
+    s: &mut TcpStream,
+    boxes: &[u8],
+    seconds: u64,
+    predicate: impl Fn(u32, &[u8]) -> bool,
+) -> Result<()> {
+    let start = Instant::now();
+    let mut last = (0, vec![]);
+    while start.elapsed() < Duration::from_secs(seconds) {
+        last = status(s, boxes)?;
+        if predicate(last.0, &last.1) {
+            return Ok(());
+        }
+        thread::sleep(Duration::from_millis(200));
+    }
+    bail!(
+        "Betaflight readiness timeout: arming_flags={} modes={:?}",
+        last.0,
+        last.1
+    )
+}
+// Packet attitude is chosen so upstream reconstructs Rz(-pi/2)*q_ENU,
+// i.e. the physical FLU-body to NWU-world rotation, including its bridge rotation.
+fn fdm(plant: &Plant, t: f64) -> Vec<u8> {
+    let [r, p, y] = plant.euler();
+    let (sr, cr) = (r / 2.).sin_cos();
+    let (sp, cp) = (p / 2.).sin_cos();
+    let (sy, cy) = (y / 2.).sin_cos();
+    let q = [
+        cr * cp * cy + sr * sp * sy,
+        sr * cp * cy - cr * sp * sy,
+        cr * sp * cy + sr * cp * sy,
+        cr * cp * sy - sr * sp * cy,
+    ];
+    let (g, a) = plant.imu_flu();
+    let pos = plant.position();
+    let v = plant.velocity();
+    let values = [
+        t,
+        g[0] as f64,
+        -g[1] as f64,
+        g[2] as f64,
+        -a[0] as f64,
+        -a[1] as f64,
+        -a[2] as f64,
+        q[3],
+        q[2],
+        q[1],
+        q[0],
+        v[0],
+        v[1],
+        v[2],
+        -86.9212 - pos[0] / (111319.49079327358 * 40.4237f64.to_radians().cos()),
+        40.4237 - pos[1] / 111319.49079327358,
+        200. + pos[2],
+        101325.,
+    ];
+    values.iter().flat_map(|x| x.to_le_bytes()).collect()
+}
+pub fn run(args: impl Iterator<Item = std::ffi::OsString>) -> Result<()> {
+    let args: Vec<_> = args.collect();
+    if args.len() < 3 {
+        bail!(
+            "betaflight-probe BINARY PLANT_DIRECTORY OUTPUT_DIRECTORY [--hover] [--sensor-hz 400] [--takeoff-ms 1000] [--hold-throttle 1690] [--yaw-p 45] [--yaw-i 20] [--heading-p 30]"
+        );
+    }
+    let mut yaw_p = 45u8;
+    // Tuning for the shared 2 kg RDD2 model, not a physical-drone recommendation.
+    let mut yaw_i = 20u8;
+    let mut heading_p = 30u8;
+    let mut sensor_hz = 400u64;
+    let mut hover = false;
+    let mut takeoff_ms = 1000u64;
+    let mut hold_throttle = 1690u16;
+    let mut extra = args[3..].iter();
+    while let Some(arg) = extra.next() {
+        match arg.to_str() {
+            Some("--hover") => hover = true,
+            Some("--yaw-p") => {
+                yaw_p = extra
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("missing yaw P"))?
+                    .to_str()
+                    .ok_or_else(|| anyhow::anyhow!("invalid yaw P"))?
+                    .parse()?
+            }
+            Some("--yaw-i") => {
+                yaw_i = extra
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("missing yaw I"))?
+                    .to_str()
+                    .ok_or_else(|| anyhow::anyhow!("invalid yaw I"))?
+                    .parse()?
+            }
+            Some("--heading-p") => {
+                heading_p = extra
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("missing heading P"))?
+                    .to_str()
+                    .ok_or_else(|| anyhow::anyhow!("invalid heading P"))?
+                    .parse()?
+            }
+            Some("--sensor-hz") => {
+                sensor_hz = extra
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("missing sensor rate"))?
+                    .to_str()
+                    .ok_or_else(|| anyhow::anyhow!("invalid sensor rate"))?
+                    .parse()?
+            }
+            Some("--takeoff-ms") => {
+                takeoff_ms = extra
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("missing takeoff duration"))?
+                    .to_str()
+                    .ok_or_else(|| anyhow::anyhow!("invalid duration"))?
+                    .parse()?
+            }
+            Some("--hold-throttle") => {
+                hold_throttle = extra
+                    .next()
+                    .ok_or_else(|| anyhow::anyhow!("missing hold throttle"))?
+                    .to_str()
+                    .ok_or_else(|| anyhow::anyhow!("invalid throttle"))?
+                    .parse()?
+            }
+            _ => bail!("unknown option: {arg:?}"),
+        }
+    }
+    if !(500..=3000).contains(&takeoff_ms) || !(1100..=1800).contains(&hold_throttle) {
+        bail!("takeoff duration or throttle outside diagnostic bounds");
+    }
+    if ![400, 800, 1600].contains(&sensor_hz) {
+        bail!("sensor rate must be 400, 800 or 1600 Hz");
+    }
+    if yaw_p > 200 || yaw_i > 200 || heading_p > 200 {
+        bail!("yaw gains must be at most 200");
+    }
+    let bridge_dt = 1.0 / sensor_hz as f64;
+    let binary = fs::canonicalize(&args[0])?;
+    let (library, description) = physics::host_paths(&PathBuf::from(&args[1]))?;
+    let out = PathBuf::from(&args[2]);
+    fs::create_dir_all(&out)?;
+    let out = fs::canonicalize(out)?;
+    if out.join("eeprom.bin").exists() {
+        bail!("use a fresh output directory to preserve prior evidence");
+    }
+    let config = "feature GPS\nset gps_provider = VIRTUAL\nset debug_mode = FLIGHT_PLAN\nset failsafe_procedure = AUTO-LAND\naux 0 0 0 1700 2100 0 0\naux 1 56 1 1700 2100 0 0\naux 2 1 2 1700 2100 0 0\nset mag_calibration = 1,1,1\nset ap_hover_throttle = 1690\nset ap_yaw_mode = FIXED\nset ap_waypoint_hold_radius = 100\nwaypoint insert 0 40.4237000 -86.9212000 20150 30 hold 250 figure8\nwaypoint insert 1 40.4237000 -86.9212000 20150 30 land 0 none\n";
+    let config = if hover {
+        config.replace("hold 250 figure8", "hold 250 none")
+    } else {
+        config.to_string()
+    };
+    let config =
+        format!("{config}set p_yaw = {yaw_p}\nset i_yaw = {yaw_i}\nset ap_yaw_p = {heading_p}\n");
+    fs::write(out.join("config.txt"), config)?;
+    let provision = Command::new(&binary)
+        .args(["--config", out.join("config.txt").to_str().unwrap()])
+        .current_dir(&out)
+        .output()?;
+    fs::write(
+        out.join("provision.log"),
+        [provision.stdout, provision.stderr].concat(),
+    )?;
+    if !provision.status.success() {
+        bail!("Betaflight configuration failed");
+    }
+    let motor = UdpSocket::bind("127.0.0.1:9002")?;
+    motor.set_nonblocking(true)?;
+    let socket = UdpSocket::bind("127.0.0.1:0")?;
+    let log = File::create(out.join("firmware.log"))?;
+    let mut child = Command::new("stdbuf")
+        .arg("-oL")
+        .arg(&binary)
+        .current_dir(&out)
+        .stdout(Stdio::from(log.try_clone()?))
+        .stderr(Stdio::from(log))
+        .spawn()?;
+    let stop = Arc::new(AtomicBool::new(false));
+    let channels = Arc::new(Mutex::new([1000u16; 16]));
+    {
+        let mut c = channels.lock().unwrap();
+        c[0] = 1500;
+        c[1] = 1500;
+        c[3] = 1500;
+    }
+    let ground = Arc::new(Mutex::new(GroundState::default()));
+    let worker_ground = ground.clone();
+    let landing = Arc::new(AtomicBool::new(false));
+    let worker_landing = landing.clone();
+    let worker_stop = stop.clone();
+    let worker_channels = channels.clone();
+    let csv = out.join("mission-trajectory.csv");
+    let plant_hash = physics::file_sha256(&library)?;
+    let worker = thread::spawn(move || -> Result<serde_json::Value> {
+        let mut plant = Plant::open(&library, &description)?;
+        let mut trajectory = BufWriter::new(File::create(csv)?);
+        writeln!(
+            trajectory,
+            "time_s,x_m,y_m,z_m,roll_rad,pitch_rad,yaw_rad,m1,m2,m3,m4"
+        )?;
+        let start = Instant::now();
+        let mut step = 0u64;
+        let mut max_alt: f64 = 0.;
+        let mut raw = [0f32; 4];
+        let mut last_motor = Instant::now();
+        let mut motor_packets = 0u64;
+        let mut pre_landing_metrics = None;
+        let mut tail = VecDeque::with_capacity((15 * sensor_hz) as usize);
+        while !worker_stop.load(Ordering::Relaxed) {
+            let t = step as f64 * bridge_dt;
+            let mut rc = t.to_le_bytes().to_vec();
+            for c in *worker_channels.lock().unwrap() {
+                rc.extend(c.to_le_bytes());
+            }
+            socket.send_to(&rc, "127.0.0.1:9004")?;
+            socket.send_to(&fdm(&plant, t), "127.0.0.1:9003")?;
+            loop {
+                let mut buf = [0u8; 64];
+                match motor.recv_from(&mut buf) {
+                    Ok((n, peer)) => {
+                        if n != 16 || !peer.ip().is_loopback() {
+                            bail!("invalid motor datagram {n}");
+                        }
+                        raw = std::array::from_fn(|i| {
+                            f32::from_le_bytes(buf[i * 4..i * 4 + 4].try_into().unwrap())
+                        });
+                        if !raw.iter().all(|x| x.is_finite() && (0.0..=1.0).contains(x)) {
+                            bail!("invalid motor values {raw:?}");
+                        }
+                        last_motor = Instant::now();
+                        motor_packets += 1;
+                    }
+                    Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => break,
+                    Err(e) => return Err(e.into()),
+                }
+            }
+            if t > 2. && last_motor.elapsed() > Duration::from_millis(500) {
+                bail!("Betaflight motor stream stale");
+            }
+            let m = [raw[1], raw[0], raw[2], raw[3]];
+            for _ in 0..(1600 / sensor_hz) {
+                plant.step(m, 0.000625)?;
+            }
+            step += 1;
+            let p = plant.position();
+            let e = plant.euler();
+            max_alt = max_alt.max(p[2]);
+            {
+                let mut g = worker_ground.lock().unwrap();
+                g.altitude = p[2];
+                g.vertical_speed = plant.vertical_speed();
+                g.settled_samples = if grounded(g.altitude, g.vertical_speed, m) {
+                    g.settled_samples + 1
+                } else {
+                    0
+                };
+            }
+            if worker_landing.load(Ordering::Relaxed) && pre_landing_metrics.is_none() {
+                pre_landing_metrics = Some(tail_metrics(&tail));
+            }
+            if tail.len() == (15 * sensor_hz) as usize {
+                tail.pop_front();
+            }
+            tail.push_back(FlightSample {
+                time: step as f64 * bridge_dt,
+                altitude: p[2],
+                motors: m,
+            });
+            writeln!(
+                trajectory,
+                "{},{},{},{},{},{},{},{},{},{},{}",
+                step as f64 * bridge_dt,
+                p[0],
+                p[1],
+                p[2],
+                e[0],
+                e[1],
+                e[2],
+                m[0],
+                m[1],
+                m[2],
+                m[3]
+            )?;
+            if !p.iter().chain(e.iter()).all(|x| x.is_finite())
+                || p[0].abs() > 5.
+                || p[1].abs() > 5.
+                || p[2] > 4.
+                || e[0].abs() > 0.8
+                || e[1].abs() > 0.8
+            {
+                bail!("flight bounds exceeded: position={p:?}, attitude={e:?}");
+            }
+            let deadline = start + Duration::from_secs_f64(step as f64 * bridge_dt);
+            if deadline > Instant::now() {
+                thread::sleep(deadline - Instant::now());
+            }
+        }
+        trajectory.flush()?;
+        Ok(
+            json!({"simulated_seconds":step as f64*bridge_dt,"maximum_altitude_m":max_alt,"motor_packets":motor_packets,"final_position_enu_m":plant.position(),"trailing_15s_diagnostics":tail_metrics(&tail),"last_15s_before_landing_observed":pre_landing_metrics,"final_vertical_speed_m_s":plant.vertical_speed(),"ground_settled_samples":worker_ground.lock().unwrap().settled_samples}),
+        )
+    });
+    let mut phase = "connect";
+    let mut holding_samples = 0u64;
+    let mut landing_observed = false;
+    let mut native_disarmed = false;
+    let mut touchdown_altitude_m = None;
+    let mut telemetry = BufWriter::new(File::create(out.join("mission-status.csv"))?);
+    writeln!(
+        telemetry,
+        "sample,nav_state,abort_reason,waypoint_index,estimated_altitude_cm,estimated_vario_cm_s"
+    )?;
+    let result = (|| -> Result<()> {
+        let deadline = Instant::now() + Duration::from_secs(10);
+        let mut s = loop {
+            match TcpStream::connect("127.0.0.1:5761") {
+                Ok(s) => break s,
+                Err(e) => {
+                    if Instant::now() > deadline {
+                        return Err(e.into());
+                    }
+                    thread::sleep(Duration::from_millis(100));
+                }
+            }
+        };
+        s.set_read_timeout(Some(Duration::from_secs(3)))?;
+        s.set_write_timeout(Some(Duration::from_secs(3)))?;
+        thread::sleep(Duration::from_secs(2));
+        let boxes = request(&mut s, 119)?;
+        phase = "navigation readiness";
+        wait_status(&mut s, &boxes, 40, |f, _| f == 0)?;
+        request(&mut s, 205)?;
+        thread::sleep(Duration::from_secs(2));
+        wait_status(&mut s, &boxes, 20, |f, _| f == 0)?;
+        phase = "arming";
+        {
+            let mut c = channels.lock().unwrap();
+            c[6] = 1800;
+            c[4] = 1800;
+        }
+        wait_status(&mut s, &boxes, 8, |_, m| m.contains(&0))?;
+        phase = "takeoff";
+        channels.lock().unwrap()[2] = 1700;
+        thread::sleep(Duration::from_millis(takeoff_ms));
+        phase = "engage native planner";
+        channels.lock().unwrap()[5] = 1800;
+        wait_status(&mut s, &boxes, 10, |_, m| {
+            [56, 3, 11].iter().all(|x| m.contains(x))
+        })?;
+        channels.lock().unwrap()[2] = hold_throttle;
+        phase = "native planner window";
+        for sample in 0..600 {
+            let (_, m) = status(&mut s, &boxes)?;
+            let d = request(&mut s, 254)?;
+            if d.len() < 6 {
+                bail!("short mission debug telemetry");
+            }
+            let state = i16::from_le_bytes(d[0..2].try_into()?);
+            let abort = i16::from_le_bytes(d[2..4].try_into()?);
+            let index = i16::from_le_bytes(d[4..6].try_into()?);
+            let altitude = request(&mut s, 109)?;
+            if altitude.len() < 6 {
+                bail!("short altitude telemetry");
+            }
+            let altitude_cm = i32::from_le_bytes(altitude[0..4].try_into()?);
+            let vario_cm_s = i16::from_le_bytes(altitude[4..6].try_into()?);
+            writeln!(
+                telemetry,
+                "{sample},{state},{abort},{index},{altitude_cm},{vario_cm_s}"
+            )?;
+            if state == 2 && abort == 0 {
+                holding_samples += 1;
+            }
+            if state == 5 || abort != 0 {
+                bail!("native mission aborted: state={state} reason={abort}");
+            }
+            if state == 4 {
+                landing_observed = true;
+                landing.store(true, Ordering::Relaxed);
+                phase = "native landing";
+            }
+            if !m.contains(&0) {
+                if !landing_observed {
+                    bail!("disarmed before native landing");
+                }
+                let g = *ground.lock().unwrap();
+                touchdown_altitude_m = Some(g.altitude);
+                if !(0.05..=0.20).contains(&g.altitude) || g.vertical_speed.abs() > 0.15 {
+                    bail!(
+                        "native disarm before verified touchdown: z={} vz={}",
+                        g.altitude,
+                        g.vertical_speed
+                    );
+                }
+                native_disarmed = true;
+                break;
+            }
+            if ![56, 3, 11].iter().all(|id| m.contains(id)) {
+                bail!("lost autonomous modes: {m:?}");
+            }
+            thread::sleep(Duration::from_millis(200));
+        }
+        if !native_disarmed {
+            bail!("native landing/disarm timeout");
+        }
+        if holding_samples < 100 {
+            bail!("native HOLD not observed for at least 100 samples");
+        }
+        // Lower the RC arm switch only after firmware has disarmed itself.
+        channels.lock().unwrap()[4] = 1000;
+        thread::sleep(Duration::from_secs(3));
+        if ground.lock().unwrap().settled_samples < 2 * sensor_hz {
+            bail!("landing did not settle for two seconds with zero motor commands");
+        }
+        phase = "landed and disarmed";
+        Ok(())
+    })();
+    stop.store(true, Ordering::Relaxed);
+    let worker_result = worker
+        .join()
+        .map_err(|_| anyhow::anyhow!("plant worker panicked"))?;
+    let _ = child.kill();
+    let _ = child.wait();
+    let report = json!({"adapter":"betaflight","yaw_p":yaw_p,"yaw_i":yaw_i,"heading_p":heading_p,"sensor_hz":sensor_hz,"scenario":if hover {"hover"} else {"figure-eight"},"takeoff_ms":takeoff_ms,"hold_throttle_us":hold_throttle,"phase":phase,"native_holding_samples":holding_samples,"landing_observed":landing_observed,"native_disarmed":native_disarmed,"touchdown_altitude_m":touchdown_altitude_m,"passed":result.is_ok()&&worker_result.is_ok(),"plant_sha256":plant_hash,"executable_sha256":physics::file_sha256(&binary)?,"qualification":"integration only; native planner diagnostic is not the timed common reference; landing checked against ground truth and motor output; wall-clock coupled SITL","control_error":result.as_ref().err().map(|e|format!("{e:#}")),"plant_error":worker_result.as_ref().err().map(|e|format!("{e:#}")),"plant":worker_result.as_ref().ok()});
+    telemetry.flush()?;
+    fs::write(out.join("report.json"), serde_json::to_vec_pretty(&report)?)?;
+    println!("{report}");
+    result?;
+    worker_result?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn landing_requires_ground_contact_rest_and_stopped_motors() {
+        assert!(grounded(0.0984, 0.0, [0.0; 4]));
+        assert!(!grounded(1.5, 0.0, [0.0; 4]));
+        assert!(!grounded(0.0984, -0.5, [0.0; 4]));
+        assert!(!grounded(0.0984, 0.0, [0.1; 4]));
+        assert!(!grounded(f64::NAN, 0.0, [0.0; 4]));
+    }
+    #[test]
+    fn altitude_error_and_motor_limits_have_explicit_units() {
+        let samples = VecDeque::from([
+            FlightSample {
+                time: 10.0,
+                altitude: 1.4,
+                motors: [0.5; 4],
+            },
+            FlightSample {
+                time: 10.5,
+                altitude: 1.6,
+                motors: [0.0, 0.5, 1.0, 0.5],
+            },
+        ]);
+        let m = tail_metrics(&samples);
+        assert!((m["altitude_rmse_m"].as_f64().unwrap() - 0.1).abs() < 1e-12);
+        assert_eq!(m["mean_motor_spread_normalized"], 0.5);
+        assert_eq!(m["fraction_samples_any_motor_within_1pct_of_limit"], 0.5);
+        assert_eq!(m["window_start_s"], 10.0);
+        assert_eq!(m["window_end_s"], 10.5);
+        assert_eq!(m["samples"], 2);
+        assert!(tail_metrics(&VecDeque::new()).is_null());
+    }
+}
