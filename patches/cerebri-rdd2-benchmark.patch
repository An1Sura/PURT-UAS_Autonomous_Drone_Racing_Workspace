@@ -0,0 +1,267 @@
+//! Narrow MAVLink 1 diagnostic client. Layouts/CRC extras from the pinned common dialect.
+//! Loopback only; no force-arm, parameter writes, or arming-check overrides.
+use crate::reference::Reference;
+use anyhow::{Result, bail};
+use serde::Serialize;
+use std::io::ErrorKind;
+use std::net::{SocketAddr, UdpSocket};
+fn crc(bytes: &[u8], extra: u8) -> u16 {
+    let mut crc = 0xffffu16;
+    for &b in bytes.iter().chain(std::iter::once(&extra)) {
+        let mut tmp = b ^ crc as u8;
+        tmp ^= tmp << 4;
+        crc = (crc >> 8) ^ ((tmp as u16) << 8) ^ ((tmp as u16) << 3) ^ ((tmp as u16) >> 4);
+    }
+    crc
+}
+fn packet(seq: u8, id: u8, extra: u8, payload: &[u8]) -> Vec<u8> {
+    let mut b = vec![0xfe, payload.len() as u8, seq, 255, 190, id];
+    b.extend_from_slice(payload);
+    b.extend_from_slice(&crc(&b[1..], extra).to_le_bytes());
+    b
+}
+#[derive(Default, Serialize)]
+pub struct Status {
+    pub heartbeat_seen: bool,
+    pub heartbeat_count: u64,
+    pub armed: bool,
+    pub mode: u32,
+    pub ekf_flags: Option<u16>,
+    pub gps_fix: Option<u8>,
+    pub gps_satellites: Option<u8>,
+    pub acknowledgements: Vec<(u16, u8)>,
+    pub messages: Vec<String>,
+}
+pub struct FlightLink {
+    socket: UdpSocket,
+    peer: Option<SocketAddr>,
+    seq: u8,
+    pub status: Status,
+}
+impl FlightLink {
+    pub fn bind() -> Result<Self> {
+        let socket = UdpSocket::bind("127.0.0.1:0")?;
+        socket.set_nonblocking(true)?;
+        Ok(Self {
+            socket,
+            peer: None,
+            seq: 0,
+            status: Status::default(),
+        })
+    }
+    pub fn port(&self) -> Result<u16> {
+        Ok(self.socket.local_addr()?.port())
+    }
+    pub fn poll(&mut self) -> Result<()> {
+        let mut bytes = [0; 65535];
+        loop {
+            let (n, peer) = match self.socket.recv_from(&mut bytes) {
+                Ok(x) => x,
+                Err(e) if e.kind() == ErrorKind::WouldBlock => break,
+                Err(e) => return Err(e.into()),
+            };
+            if !peer.ip().is_loopback() || self.peer.is_some_and(|p| p != peer) {
+                continue;
+            }
+            let mut i = 0;
+            while i + 8 <= n {
+                if bytes[i] != 0xfe {
+                    i += 1;
+                    continue;
+                }
+                let size = bytes[i + 1] as usize;
+                if i + size + 8 > n {
+                    break;
+                }
+                let frame = &bytes[i..i + size + 8];
+                i += size + 8;
+                let extra = match frame[5] {
+                    0 => 50,
+                    77 => 143,
+                    253 => 83,
+                    193 => 71,
+                    24 => 24,
+                    _ => continue,
+                };
+                if crc(&frame[1..size + 6], extra)
+                    != u16::from_le_bytes([frame[size + 6], frame[size + 7]])
+                {
+                    continue;
+                }
+                if frame[3] != 1 || frame[4] != 1 {
+                    continue;
+                }
+                self.peer = Some(peer);
+                let p = &frame[6..6 + size];
+                match frame[5] {
+                    0 if size == 9 => {
+                        self.status.heartbeat_seen = true;
+                        self.status.heartbeat_count += 1;
+                        self.status.mode = u32::from_le_bytes(p[..4].try_into().unwrap());
+                        self.status.armed = p[6] & 128 != 0;
+                    }
+                    193 if size >= 22 => {
+                        self.status.ekf_flags = Some(u16::from_le_bytes([p[20], p[21]]))
+                    }
+                    24 if size >= 30 => {
+                        self.status.gps_fix = Some(p[28]);
+                        self.status.gps_satellites = Some(p[29]);
+                    }
+                    77 if size >= 3 => self
+                        .status
+                        .acknowledgements
+                        .push((u16::from_le_bytes([p[0], p[1]]), p[2])),
+                    253 if size >= 51 => {
+                        let text = String::from_utf8_lossy(&p[1..51])
+                            .trim_end_matches('\0')
+                            .to_string();
+                        if self.status.messages.last() != Some(&text) {
+                            self.status.messages.push(text);
+                        }
+                    }
+                    _ => {}
+                }
+            }
+        }
+        Ok(())
+    }
+    fn send(&mut self, id: u8, extra: u8, payload: &[u8]) -> Result<()> {
+        let peer = self
+            .peer
+            .ok_or_else(|| anyhow::anyhow!("no validated MAVLink peer"))?;
+        let b = packet(self.seq, id, extra, payload);
+        self.seq = self.seq.wrapping_add(1);
+        self.socket.send_to(&b, peer)?;
+        Ok(())
+    }
+    pub fn request_status(&mut self) -> Result<()> {
+        self.send(66, 148, &[4, 0, 1, 1, 0, 1])
+    }
+    pub fn heartbeat(&mut self) -> Result<()> {
+        self.send(0, 50, &[0, 0, 0, 0, 6, 8, 0, 4, 3])
+    }
+    pub fn command(&mut self, id: u16, params: [f32; 7]) -> Result<()> {
+        if !params.iter().all(|x| x.is_finite()) {
+            bail!("nonfinite command");
+        }
+        let mut p = Vec::new();
+        for v in params {
+            p.extend_from_slice(&v.to_le_bytes());
+        }
+        p.extend_from_slice(&id.to_le_bytes());
+        p.extend_from_slice(&[1, 1, 0]);
+        self.send(76, 152, &p)
+    }
+    pub fn guided(&mut self) -> Result<()> {
+        let mut p = 4u32.to_le_bytes().to_vec();
+        p.extend_from_slice(&[1, 1]);
+        self.send(11, 89, &p)
+    }
+    pub fn reference(&mut self, time_ms: u32, r: Reference) -> Result<()> {
+        if !r
+            .position_enu_m
+            .iter()
+            .chain(r.velocity_enu_m_s.iter())
+            .chain(std::iter::once(&r.yaw_enu_rad))
+            .all(|x| x.is_finite() && x.abs() < 10000.)
+        {
+            bail!("invalid flight reference");
+        }
+        let mut p = time_ms.to_le_bytes().to_vec();
+        // MAV_FRAME_LOCAL_NED, position + velocity + yaw; ignore acceleration/yaw rate.
+        for v in [
+            r.position_enu_m[1],
+            r.position_enu_m[0],
+            -r.position_enu_m[2],
+            r.velocity_enu_m_s[1],
+            r.velocity_enu_m_s[0],
+            -r.velocity_enu_m_s[2],
+            0.,
+            0.,
+            0.,
+            std::f64::consts::FRAC_PI_2 - r.yaw_enu_rad,
+            0.,
+        ] {
+            p.extend_from_slice(&(v as f32).to_le_bytes());
+        }
+        p.extend_from_slice(&2496u16.to_le_bytes());
+        p.extend_from_slice(&[1, 1, 1]);
+        self.send(84, 143, &p)
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn heartbeat_matches_dialect_fixture() {
+        // Generated with pinned ArduPilot mavlink_msg_heartbeat_pack_chan (MAVLink 1).
+        let b = packet(0, 0, 50, &[0, 0, 0, 0, 6, 8, 0, 4, 3]);
+        assert_eq!(
+            b,
+            [
+                0xfe, 9, 0, 255, 190, 0, 0, 0, 0, 0, 6, 8, 0, 4, 3, 0x49, 0x21
+            ]
+        );
+    }
+}
+
+#[cfg(test)]
+mod wire_tests {
+    use super::*;
+    fn hex(b: &[u8]) -> String {
+        b.iter().map(|x| format!("{x:02x}")).collect()
+    }
+    #[test]
+    fn commands_match_generated_c_dialect_packets() {
+        let mut link = FlightLink::bind().unwrap();
+        let peer = UdpSocket::bind("127.0.0.1:0").unwrap();
+        peer.set_read_timeout(Some(std::time::Duration::from_secs(1)))
+            .unwrap();
+        link.peer = Some(peer.local_addr().unwrap());
+        let mut b = [0; 300];
+        link.guided().unwrap();
+        let n = peer.recv(&mut b).unwrap();
+        assert_eq!(hex(&b[..n]), "fe0600ffbe0b040000000101afeb");
+        link.seq = 0;
+        link.command(400, [1., 0., 0., 0., 0., 0., 0.]).unwrap();
+        let n = peer.recv(&mut b).unwrap();
+        assert_eq!(
+            hex(&b[..n]),
+            "fe2100ffbe4c0000803f0000000000000000000000000000000000000000000000009001010100390a"
+        );
+        link.seq = 0;
+        link.reference(50000, crate::reference::sample(0.)).unwrap();
+        let n = peer.recv(&mut b).unwrap();
+        // IEEE negative zero from ENU -> NED is equivalent but byte-distinct.
+        assert_eq!(b[6..10], 50000u32.to_le_bytes());
+        assert_eq!(f32::from_le_bytes(b[18..22].try_into().unwrap()), -1.5);
+        assert_eq!(&b[54..59], &[0xc0, 9, 1, 1, 1]);
+        assert_eq!(n, 61);
+        let mut invalid = crate::reference::sample(0.);
+        invalid.position_enu_m[0] = f64::NAN;
+        assert!(link.reference(0, invalid).is_err());
+    }
+    #[test]
+    fn telemetry_requires_valid_crc_and_autopilot_identity() {
+        let mut link = FlightLink::bind().unwrap();
+        let peer = UdpSocket::bind("127.0.0.1:0").unwrap();
+        let mut b = packet(0, 0, 50, &[4, 0, 0, 0, 2, 3, 128, 4, 3]);
+        peer.send_to(&b, link.socket.local_addr().unwrap()).unwrap();
+        link.poll().unwrap();
+        assert!(!link.status.heartbeat_seen); // wrong system/component
+        b[3] = 1;
+        b[4] = 1;
+        let c = crc(&b[1..15], 50);
+        b[15..].copy_from_slice(&c.to_le_bytes());
+        b[15] ^= 1;
+        peer.send_to(&b, link.socket.local_addr().unwrap()).unwrap();
+        link.poll().unwrap();
+        assert!(!link.status.heartbeat_seen);
+        b[15] ^= 1;
+        peer.send_to(&b, link.socket.local_addr().unwrap()).unwrap();
+        link.poll().unwrap();
+        assert!(link.status.armed);
+        assert_eq!(link.status.mode, 4);
+        assert_eq!(link.status.heartbeat_count, 1);
+    }
+}
