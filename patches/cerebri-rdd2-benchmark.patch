+++ b/xtask/src/benchmark.rs
@@ -0,0 +1,283 @@
+//! Stack-neutral lockstep boundary. The runner owns time, sensors and physics.
+use std::time::{Duration, Instant};
+
+use anyhow::{Result, bail};
+use serde::Serialize;
+
+pub const GNSS_ORIGIN_LATITUDE_DEG: f64 = 40.4237;
+pub const GNSS_ORIGIN_LONGITUDE_DEG: f64 = -86.9212;
+pub const GNSS_ORIGIN_ALTITUDE_MSL_M: f64 = 200.0;
+
+pub const GNSS_PERIOD_NS: u64 = 100_000_000;
+
+/// Held 10 Hz observation in the plant's ENU frame, not a live truth accessor.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct GnssObservation {
+    pub timestamp_ns: u64,
+    pub position_enu_m: [f64; 3],
+    pub velocity_enu_m_s: [f64; 3],
+    pub valid: bool,
+}
+
+#[derive(Default)]
+pub struct SyntheticGnss {
+    latest: GnssObservation,
+}
+
+impl SyntheticGnss {
+    pub fn sample(
+        &mut self,
+        position: [f64; 3],
+        velocity: [f64; 3],
+        time_ns: u64,
+    ) -> GnssObservation {
+        let timestamp_ns = time_ns / GNSS_PERIOD_NS * GNSS_PERIOD_NS;
+        if timestamp_ns != 0 && timestamp_ns > self.latest.timestamp_ns {
+            let valid = position
+                .iter()
+                .chain(velocity.iter())
+                .all(|x| x.is_finite())
+                && position.iter().all(|x| x.abs() <= 10_000.0)
+                && velocity.iter().all(|x| x.abs() <= 300.0)
+                && (-1_000.0..=20_000.0).contains(&(GNSS_ORIGIN_ALTITUDE_MSL_M + position[2]));
+            self.latest = GnssObservation {
+                timestamp_ns,
+                position_enu_m: position,
+                velocity_enu_m_s: velocity,
+                valid,
+            };
+        }
+        self.latest
+    }
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct SensorFrame {
+    /// End of this controller interval. Physics advances only after a response.
+    pub target_time_ns: u64,
+    pub gyro_flu_rad_s: [f32; 3],
+    pub specific_force_flu_m_s2: [f32; 3],
+    pub gnss: GnssObservation,
+}
+
+/// Initial qualification command interface; not a shared position controller.
+#[derive(Clone, Copy, Debug)]
+pub struct PilotCommand {
+    /// RC convention: roll, pitch, throttle, yaw, arm, mode; 1000..2000 us.
+    pub channels_us: [i32; 16],
+    pub square_plan: Option<SquarePlan>,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct SquarePlan {
+    pub sequence: i32,
+    pub side_m: f32,
+    pub speed_m_s: f32,
+}
+
+pub struct ActuatorFrame<D> {
+    pub target_time_ns: u64,
+    /// Normalized [0,1], in the FMI plant's motor order, not stack mixer order.
+    pub motors: [f32; 4],
+    pub diagnostics: D,
+}
+
+pub trait FlightStackAdapter {
+    type Diagnostics;
+    fn step(
+        &mut self,
+        sensors: &SensorFrame,
+        command: &PilotCommand,
+        timeout: Duration,
+    ) -> Result<ActuatorFrame<Self::Diagnostics>>;
+}
+
+pub trait Dynamics {
+    fn advance(&mut self, motors: [f32; 4], dt_s: f64) -> Result<()>;
+}
+
+/// Separate exchange from commit so startup retries cannot advance the plant.
+pub fn exchange<A: FlightStackAdapter>(
+    adapter: &mut A,
+    sensors: &SensorFrame,
+    command: &PilotCommand,
+    timeout: Duration,
+) -> Result<(ActuatorFrame<A::Diagnostics>, Duration)> {
+    let start = Instant::now();
+    let output = adapter.step(sensors, command, timeout)?;
+    let elapsed = start.elapsed();
+    if output.target_time_ns != sensors.target_time_ns {
+        bail!(
+            "stale actuator response: expected {}, got {}",
+            sensors.target_time_ns,
+            output.target_time_ns
+        );
+    }
+    if output
+        .motors
+        .iter()
+        .any(|x| !x.is_finite() || !(0.0..=1.0).contains(x))
+    {
+        bail!("adapter returned nonfinite or out-of-range motor commands");
+    }
+    Ok((output, elapsed))
+}
+
+pub fn commit<P: Dynamics, D>(plant: &mut P, output: &ActuatorFrame<D>, dt_s: f64) -> Result<()> {
+    if !dt_s.is_finite() || dt_s <= 0.0 {
+        bail!("plant step must be positive and finite");
+    }
+    plant.advance(output.motors, dt_s)
+}
+
+#[derive(Debug, Default, Serialize)]
+pub struct ExchangeMetrics {
+    pub samples: usize,
+    pub round_trip_mean_us: f64,
+    pub round_trip_stddev_us: f64,
+    pub round_trip_p95_us: f64,
+    pub round_trip_max_us: f64,
+    pub armed_motor_samples: u64,
+    pub armed_motor_samples_at_limit: u64,
+    #[serde(skip)]
+    times_us: Vec<f64>,
+}
+
+impl ExchangeMetrics {
+    pub fn record(&mut self, elapsed: Duration, motors: [f32; 4], armed: bool) {
+        self.times_us.push(elapsed.as_secs_f64() * 1e6);
+        if armed {
+            self.armed_motor_samples += 4;
+            self.armed_motor_samples_at_limit +=
+                motors.iter().filter(|&&x| x <= 0.0 || x >= 1.0).count() as u64;
+        }
+    }
+    pub fn finish(&mut self) {
+        self.samples = self.times_us.len();
+        if self.samples == 0 {
+            return;
+        }
+        self.round_trip_mean_us = self.times_us.iter().sum::<f64>() / self.samples as f64;
+        self.round_trip_stddev_us = (self
+            .times_us
+            .iter()
+            .map(|x| (x - self.round_trip_mean_us).powi(2))
+            .sum::<f64>()
+            / self.samples as f64)
+            .sqrt();
+        self.times_us.sort_by(f64::total_cmp);
+        self.round_trip_p95_us = self.times_us[(self.samples * 95).div_ceil(100) - 1];
+        self.round_trip_max_us = *self.times_us.last().unwrap();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    struct Fake {
+        time: u64,
+        motors: [f32; 4],
+        fail: bool,
+    }
+    impl FlightStackAdapter for Fake {
+        type Diagnostics = ();
+        fn step(
+            &mut self,
+            _: &SensorFrame,
+            _: &PilotCommand,
+            _: Duration,
+        ) -> Result<ActuatorFrame<()>> {
+            if self.fail {
+                bail!("timeout");
+            }
+            Ok(ActuatorFrame {
+                target_time_ns: self.time,
+                motors: self.motors,
+                diagnostics: (),
+            })
+        }
+    }
+    #[derive(Default)]
+    struct TestPlant {
+        steps: Vec<([f32; 4], f64)>,
+    }
+    impl Dynamics for TestPlant {
+        fn advance(&mut self, motors: [f32; 4], dt: f64) -> Result<()> {
+            self.steps.push((motors, dt));
+            Ok(())
+        }
+    }
+    #[test]
+    fn failed_or_stale_exchange_never_advances_physics() {
+        let sensors = SensorFrame {
+            target_time_ns: 625_000,
+            gyro_flu_rad_s: [0.; 3],
+            specific_force_flu_m_s2: [0.; 3],
+            gnss: GnssObservation::default(),
+        };
+        let command = PilotCommand {
+            channels_us: [1500; 16],
+            square_plan: None,
+        };
+        let mut plant = TestPlant::default();
+        for (time, motors, fail) in [
+            (0, [0.5; 4], false),
+            (625_000, [f32::NAN; 4], false),
+            (625_000, [1.1; 4], false),
+            (625_000, [0.5; 4], true),
+        ] {
+            let result = exchange(
+                &mut Fake { time, motors, fail },
+                &sensors,
+                &command,
+                Duration::from_millis(10),
+            );
+            assert!(result.is_err());
+            if let Ok((output, _)) = result {
+                commit(&mut plant, &output, 0.000625).unwrap();
+            }
+        }
+        assert!(plant.steps.is_empty());
+        let (output, _) = exchange(
+            &mut Fake {
+                time: 625_000,
+                motors: [0.1, 0.2, 0.3, 0.4],
+                fail: false,
+            },
+            &sensors,
+            &command,
+            Duration::from_millis(10),
+        )
+        .unwrap();
+        commit(&mut plant, &output, 0.000625).unwrap();
+        assert_eq!(plant.steps, vec![([0.1, 0.2, 0.3, 0.4], 0.000625)]);
+    }
+    #[test]
+    fn gnss_is_held_between_sensor_ticks() {
+        let mut sensor = SyntheticGnss::default();
+        assert!(!sensor.sample([0.; 3], [0.; 3], 99_999_999).valid);
+        let first = sensor.sample([1.; 3], [2.; 3], 100_000_000);
+        assert_eq!(first, sensor.sample([9.; 3], [8.; 3], 199_999_999));
+        assert!(!sensor.sample([f64::NAN; 3], [0.; 3], 200_000_000).valid);
+    }
+    #[test]
+    fn metrics_exclude_disarmed_motor_limits() {
+        let mut m = ExchangeMetrics::default();
+        m.record(Duration::from_micros(10), [0.; 4], false);
+        m.record(Duration::from_micros(30), [0., 0.5, 0.5, 1.], true);
+        m.finish();
+        assert_eq!(
+            (
+                m.samples,
+                m.round_trip_mean_us,
+                m.round_trip_stddev_us,
+                m.round_trip_p95_us
+            ),
+            (2, 20., 10., 30.)
+        );
+        assert_eq!(
+            (m.armed_motor_samples, m.armed_motor_samples_at_limit),
+            (4, 2)
+        );
+    }
+}
