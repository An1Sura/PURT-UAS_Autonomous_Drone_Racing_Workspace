index 0000000..780d5e5
--- /dev/null
+++ b/xtask/src/cognipilot_reference.rs
@@ -0,0 +1,243 @@
+//! Shared square reference diagnostic. Takeoff/landing still use the legacy
+//! simulator-assisted throttle law; this is not full sensor/control parity.
+use crate::{
+    Options,
+    benchmark::{self, ExchangeMetrics, PilotCommand, SensorFrame, SyntheticGnss},
+    cognipilot::CogniPilotAdapter,
+    physics::Plant,
+    protocol::{self, MissionStatusWire},
+    reference,
+    shared_memory::LockstepOutputs,
+};
+use anyhow::{Context, Result, bail};
+use serde::Serialize;
+use std::fs::{self, File};
+use std::io::{BufWriter, Write};
+use std::time::Duration;
+#[derive(Default, Serialize)]
+struct Report {
+    passed: bool,
+    plant_sha256: String,
+    description_sha256: String,
+    executable_sha256: String,
+    qualification: &'static str,
+    reference_id: &'static str,
+    adapter: &'static str,
+    simulated_seconds: f64,
+    mission_epoch_ns: Option<u64>,
+    steps: u64,
+    reference_samples: u64,
+    references_sent: u64,
+    reference_echo_checks: u64,
+    position_rmse_m: Option<f64>,
+    position_max_error_m: f64,
+    maximum_altitude_m: f64,
+    final_position_enu_m: [f64; 3],
+    armed_observed: bool,
+    final_armed: bool,
+    exchange_metrics: ExchangeMetrics,
+    error: Option<String>,
+    navigation_origin_enu_m: Option<[f64; 3]>,
+}
+pub(super) fn run<F>(options: &Options, exchange: &mut F) -> Result<()>
+where
+    F: FnMut(&protocol::LockstepInputs, Duration) -> Result<LockstepOutputs>,
+{
+    if (options.plant_dt - 0.000625).abs() > 1e-12 {
+        bail!("shared reference diagnostic requires 1600 Hz");
+    }
+    let sample = if options.figure_eight {
+        reference::figure_eight
+    } else {
+        reference::sample
+    };
+    let mut plant = Plant::open(&options.plant_library, &options.plant_description)?;
+    let mut adapter = CogniPilotAdapter {
+        exchange,
+        origin_enu_m: None,
+    };
+    let mut gnss = SyntheticGnss::default();
+    let mut report = Report {
+        plant_sha256: crate::physics::file_sha256(&options.plant_library)?,
+        description_sha256: crate::physics::file_sha256(&options.plant_description)?,
+        executable_sha256: crate::physics::file_sha256(
+            options
+                .native_sim
+                .as_ref()
+                .or(options.firmware_elf.as_ref())
+                .context("firmware path missing")?,
+        )?,
+        qualification: "shared trajectory reference diagnostic; legacy simulator-assisted takeoff/landing and unmatched sensor paths",
+        reference_id: if options.figure_eight {
+            "enu-figure-eight-v1"
+        } else {
+            reference::ID
+        },
+        adapter: "cognipilot",
+        ..Report::default()
+    };
+    let mut trajectory = crate::trajectory_writer(&options.trajectory)?;
+    let command_path = options
+        .trajectory
+        .with_file_name("commanded-trajectory.csv");
+    let mut commands = BufWriter::new(File::create(&command_path)?);
+    writeln!(commands, "time_s,x_m,y_m,z_m,vx_m_s,vy_m_s,vz_m_s,yaw_rad")?;
+    let mut held_reference = None;
+    let mut squared_sum = 0.;
+    let steps = (options.duration / options.plant_dt).round() as u64;
+    let result = (|| -> Result<()> {
+        for step in 1..=steps {
+            let target_ns = step * 625_000;
+            let time_s = target_ns as f64 * 1e-9;
+            let mission_time = report
+                .mission_epoch_ns
+                .map(|epoch| (target_ns - epoch) as f64 * 1e-9);
+            if let Some(t) = mission_time {
+                if held_reference.is_none()
+                    || (target_ns - report.mission_epoch_ns.unwrap()) % 50_000_000 == 0
+                {
+                    let r = sample((t - 8.).max(0.));
+                    held_reference = Some((target_ns, r));
+                    if (8.0..33.0).contains(&t) {
+                        report.references_sent += 1;
+                        writeln!(
+                            commands,
+                            "{time_s},{},{},{},{},{},{},{}",
+                            r.position_enu_m[0],
+                            r.position_enu_m[1],
+                            r.position_enu_m[2],
+                            r.velocity_enu_m_s[0],
+                            r.velocity_enu_m_s[1],
+                            r.velocity_enu_m_s[2],
+                            r.yaw_enu_rad
+                        )?;
+                    }
+                }
+            }
+            let (gyro, accel) = plant.imu_flu();
+            let sensors = SensorFrame {
+                target_time_ns: target_ns,
+                gyro_flu_rad_s: gyro,
+                specific_force_flu_m_s2: accel,
+                gnss: gnss.sample(plant.position(), plant.velocity(), target_ns),
+                simulator_state: None,
+            };
+            let command = PilotCommand {
+                channels_us: crate::rc_channels(mission_time, &plant),
+                square_plan: None,
+                reference: held_reference,
+            };
+            let (response, elapsed) = benchmark::exchange(
+                &mut adapter,
+                &sensors,
+                &command,
+                Duration::from_secs(if step == 1 { 30 } else { 2 }),
+            )?;
+            benchmark::commit(&mut plant, &response, options.plant_dt)?;
+            let output = response.diagnostics;
+            report.navigation_origin_enu_m = adapter.origin_enu_m;
+            report
+                .exchange_metrics
+                .record(elapsed, response.motors, output.flight_state.armed);
+            report.armed_observed |= output.flight_state.armed;
+            report.final_armed = output.flight_state.armed;
+            let required = MissionStatusWire::SOURCE_READY | MissionStatusWire::ORIGIN_VALID;
+            if report.mission_epoch_ns.is_none()
+                && output.mission_status.flags & required == required
+                && output.odometry_estimate.quality_pct() > 0
+            {
+                report.mission_epoch_ns = Some(target_ns);
+            }
+            if time_s > 5. && report.mission_epoch_ns.is_none() {
+                bail!("navigation did not become ready within 5 seconds");
+            }
+            if output.mission_status.plan_generation != 0
+                || output.mission_status.mission_state != 0
+            {
+                bail!("internal waypoint planner unexpectedly active");
+            }
+            let p = plant.position();
+            let e = plant.euler();
+            report.steps = step;
+            report.simulated_seconds = time_s;
+            report.final_position_enu_m = p;
+            report.maximum_altitude_m = report.maximum_altitude_m.max(p[2]);
+            if !p.iter().chain(e.iter()).all(|x| x.is_finite())
+                || p[0].abs() > 5.
+                || p[1].abs() > 5.
+                || p[2] > 4.
+                || e[0].abs() > 0.8
+                || e[1].abs() > 0.8
+            {
+                bail!("flight exceeded finite state, position or tilt bounds");
+            }
+            writeln!(
+                trajectory,
+                "{time_s:.9},{:.9},{:.9},{:.9},{:.9},{:.9},{:.9}",
+                p[0], p[1], p[2], e[0], e[1], e[2]
+            )?;
+            if let Some(t) = mission_time
+                && (8.0..33.0).contains(&t)
+            {
+                if t > 8.1
+                    && (!output.flight_state.armed
+                        || output.flight_state.flight_mode != 2
+                        || output.mission_status.flags & required != required)
+                {
+                    bail!("lost armed position mode or navigation during reference");
+                }
+                let r = sample(t - 8.);
+                let err: f64 = p
+                    .iter()
+                    .zip(r.position_enu_m)
+                    .map(|(x, r)| (x - r).powi(2))
+                    .sum();
+                squared_sum += err;
+                report.reference_samples += 1;
+                report.position_max_error_m = report.position_max_error_m.max(err.sqrt());
+                let (stamp, held) = held_reference.unwrap();
+                if target_ns - stamp > 10_000_000 {
+                    let expected = crate::cognipilot::reference_wire(
+                        stamp,
+                        target_ns,
+                        crate::cognipilot::to_local(held, adapter.origin_enu_m.unwrap()),
+                    )?;
+                    if output.planner_reference != expected {
+                        bail!("firmware did not echo the current external reference");
+                    }
+                    report.reference_echo_checks += 1;
+                }
+            }
+        }
+        if !report.armed_observed
+            || report.final_armed
+            || report.maximum_altitude_m < 1.
+            || plant.position()[2] > 0.2
+            || report.reference_samples != 40000
+            || report.reference_echo_checks < 10000
+        {
+            bail!(
+                "takeoff, complete reference window, echo or disarmed landing requirement not met"
+            );
+        }
+        Ok(())
+    })();
+    trajectory.flush()?;
+    commands.flush()?;
+    if report.reference_samples > 0 {
+        report.position_rmse_m = Some((squared_sum / report.reference_samples as f64).sqrt());
+    }
+    report.exchange_metrics.finish();
+    report.passed = result.is_ok();
+    report.error = result.as_ref().err().map(|e| format!("{e:#}"));
+    if let Some(parent) = options.report.parent() {
+        fs::create_dir_all(parent)?;
+    }
+    fs::write(&options.report, serde_json::to_vec_pretty(&report)?)?;
+    println!(
+        "COGNIPILOT_REFERENCE passed={} report={}",
+        report.passed,
+        options.report.display()
+    );
+    result
+}
