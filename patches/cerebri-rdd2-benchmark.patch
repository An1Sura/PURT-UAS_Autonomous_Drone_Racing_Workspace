+//! Explicit baseline fixture. Changing it creates a different experiment.
+use serde::{Deserialize, Serialize};
+use std::sync::LazyLock;
+#[derive(Clone, Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct Mission {
+    pub id: String,
+    pub controller_dt: f64,
+    pub takeoff_altitude_m: f64,
+    pub mission_side_m: f64,
+    pub mission_speed_m_s: f32,
+    pub mission_arm_delay_s: f64,
+    pub mission_takeoff_start_s: f64,
+    pub mission_takeoff_end_s: f64,
+    pub mission_position_start_s: f64,
+    pub mission_position_end_s: f64,
+    pub mission_disarm_s: f64,
+    pub default_mission_duration_s: f64,
+}
+impl Default for Mission {
+    fn default() -> Self {
+        serde_json::from_str(include_str!("../missions/rdd2-square-baseline-v1.json"))
+            .expect("checked baseline fixture")
+    }
+}
+pub static BASELINE: LazyLock<Mission> = LazyLock::new(Mission::default);
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn fixture_preserves_baseline_schedule() {
+        let m = Mission::default();
+        assert_eq!(m.default_mission_duration_s / m.controller_dt, 70400.0);
+        assert!(m.mission_arm_delay_s < m.mission_takeoff_start_s);
+        assert!(m.mission_takeoff_end_s < m.mission_position_start_s);
+        assert!(m.mission_position_end_s < m.mission_disarm_s);
+        assert!(m.mission_disarm_s + 2.0 <= m.default_mission_duration_s);
+    }
+}
