@@ -0,0 +1,354 @@
+//! ArduPilot Copter-4.7.1 JSON SITL protocol (little-endian Linux host).
+//! Connection qualification only: arming and mission commands are rejected.
+use std::net::{SocketAddr, UdpSocket};
+use std::time::{Duration, Instant};
+
+use anyhow::{Context, Result, bail};
+use serde::Serialize;
+
+use crate::benchmark::{ActuatorFrame, FlightStackAdapter, PilotCommand, SensorFrame};
+
+pub const REVISION: &str = "dbe792162d06cab66c3475fd5556bf7a120f119e";
+pub const RATE_HZ: u16 = 1600;
+
+#[derive(Debug, Serialize)]
+pub struct ServoFrame {
+    pub frame_count: u32,
+    pub frame_rate_hz: u16,
+    pub motors: [f32; 4],
+}
+
+pub fn decode(bytes: &[u8]) -> Result<ServoFrame> {
+    if bytes.len() < 8 {
+        bail!("truncated ArduPilot servo packet");
+    }
+    let magic = u16::from_le_bytes([bytes[0], bytes[1]]);
+    let expected = match magic {
+        18458 => 40,
+        29569 => 72,
+        _ => bail!("unknown ArduPilot packet magic {magic}"),
+    };
+    if bytes.len() != expected {
+        bail!("ArduPilot servo packet length mismatch");
+    }
+    let frame_rate_hz = u16::from_le_bytes([bytes[2], bytes[3]]);
+    if frame_rate_hz == 0 {
+        bail!("ArduPilot advertises a zero frame rate");
+    }
+    let frame_count = u32::from_le_bytes(bytes[4..8].try_into().unwrap());
+    let mut motors = [0.; 4];
+    // AP quad-X channels: FR, BL, FL, BR. FMI command order: FR, BR, BL, FL.
+    for (motor, channel) in motors.iter_mut().zip([0, 3, 1, 2]) {
+        let offset = 8 + channel * 2;
+        let pwm = u16::from_le_bytes([bytes[offset], bytes[offset + 1]]);
+        *motor = match pwm {
+            0 => 0., // disabled servo output
+            1000..=2000 => (f32::from(pwm) - 1000.) / 1000.,
+            _ => bail!("unexpected motor PWM {pwm}; expected 0 or 1000..2000 us"),
+        };
+    }
+    Ok(ServoFrame {
+        frame_count,
+        frame_rate_hz,
+        motors,
+    })
+}
+
+fn ned(enu: [f64; 3]) -> [f64; 3] {
+    [enu[1], enu[0], -enu[2]]
+}
+fn frd(flu: [f32; 3]) -> [f32; 3] {
+    [flu[0], -flu[1], -flu[2]]
+}
+
+pub fn encode(sensors: &SensorFrame, command: &PilotCommand) -> Result<Vec<u8>> {
+    if command.square_plan.is_some()
+        || command.channels_us[4] >= 1500
+        || command.channels_us[2] != 1000
+    {
+        bail!("ArduPilot adapter is disarmed-probe only; flight commands are not implemented");
+    }
+    let state = sensors.simulator_state.context("ArduPilot JSON requires explicit simulator ground truth; sensor parity is not yet qualified")?;
+    if !state
+        .position_enu_m
+        .iter()
+        .chain(state.velocity_enu_m_s.iter())
+        .chain(state.euler_flu_enu_rad.iter())
+        .all(|x| x.is_finite())
+        || !sensors
+            .gyro_flu_rad_s
+            .iter()
+            .chain(sensors.specific_force_flu_m_s2.iter())
+            .all(|x| x.is_finite())
+    {
+        bail!("nonfinite simulator state");
+    }
+    let [roll, pitch, yaw] = state.euler_flu_enu_rad;
+    let payload = serde_json::json!({
+        "timestamp": sensors.target_time_ns as f64 * 1e-9,
+        "imu": {"gyro": frd(sensors.gyro_flu_rad_s), "accel_body": frd(sensors.specific_force_flu_m_s2)},
+        "position": ned(state.position_enu_m),
+        "velocity": ned(state.velocity_enu_m_s),
+        "attitude": [roll,-pitch,std::f64::consts::FRAC_PI_2-yaw],
+        // No arming channel mapping is enabled in this connection test.
+        "rc": {"rc_1":1500,"rc_2":1500,"rc_3":1000,"rc_4":1500,"rc_5":1000,"rc_6":1000,"rc_7":1000,"rc_8":1000},
+        "no_lockstep": false
+    });
+    let mut bytes = vec![b'\n'];
+    serde_json::to_writer(&mut bytes, &payload)?;
+    bytes.push(b'\n');
+    Ok(bytes)
+}
+
+pub struct ArduPilotAdapter {
+    socket: UdpSocket,
+    peer: Option<SocketAddr>,
+    last_frame: Option<u32>,
+    last_time_ns: u64,
+    pub duplicates_ignored: u64,
+}
+
+impl ArduPilotAdapter {
+    pub fn bind() -> Result<Self> {
+        Ok(Self {
+            socket: UdpSocket::bind("127.0.0.1:0")?,
+            peer: None,
+            last_frame: None,
+            last_time_ns: 0,
+            duplicates_ignored: 0,
+        })
+    }
+    pub fn address(&self) -> Result<SocketAddr> {
+        Ok(self.socket.local_addr()?)
+    }
+    fn receive(&self, deadline: Instant) -> Result<(ServoFrame, SocketAddr)> {
+        loop {
+            let remaining = deadline
+                .checked_duration_since(Instant::now())
+                .context("ArduPilot response deadline expired")?;
+            if remaining.is_zero() {
+                bail!("ArduPilot response deadline expired");
+            }
+            self.socket.set_read_timeout(Some(remaining))?;
+            let mut bytes = [0u8; 73];
+            let (size, peer) = self
+                .socket
+                .recv_from(&mut bytes)
+                .context("waiting for ArduPilot servo frame")?;
+            if !peer.ip().is_loopback() || self.peer.is_some_and(|known| known != peer) {
+                continue;
+            }
+            return Ok((decode(&bytes[..size])?, peer));
+        }
+    }
+}
+
+impl FlightStackAdapter for ArduPilotAdapter {
+    type Diagnostics = ServoFrame;
+    fn step(
+        &mut self,
+        sensors: &SensorFrame,
+        command: &PilotCommand,
+        timeout: Duration,
+    ) -> Result<ActuatorFrame<ServoFrame>> {
+        if sensors.target_time_ns != self.last_time_ns + 625_000 {
+            bail!("ArduPilot probe requires contiguous 625000 ns steps");
+        }
+        let payload = encode(sensors, command)?;
+        let deadline = Instant::now() + timeout;
+        if self.peer.is_none() {
+            let (initial, peer) = self.receive(deadline)?;
+            if initial.motors.iter().any(|&x| x != 0.) {
+                bail!("ArduPilot probe received active motors at startup");
+            }
+            self.peer = Some(peer);
+            // SIM_JSON starts at its default rate before seeing simulator time.
+            // Bootstrap does not advance physics; subsequent replies must be 1600 Hz.
+            self.last_frame = Some(initial.frame_count);
+        }
+        self.socket.send_to(&payload, self.peer.unwrap())?;
+        loop {
+            let (frame, _) = self.receive(deadline)?;
+            let previous = self.last_frame.unwrap();
+            if frame.frame_count == previous {
+                self.duplicates_ignored += 1;
+                continue;
+            }
+            if frame.frame_count != previous.wrapping_add(1) {
+                bail!(
+                    "ArduPilot frame gap/reset: expected {}, got {}",
+                    previous.wrapping_add(1),
+                    frame.frame_count
+                );
+            }
+            if frame.frame_rate_hz != RATE_HZ {
+                bail!(
+                    "ArduPilot reports {} Hz after clock negotiation; expected {RATE_HZ}",
+                    frame.frame_rate_hz
+                );
+            }
+            self.last_frame = Some(frame.frame_count);
+            self.last_time_ns = sensors.target_time_ns;
+            // JSON has no response timestamp: correlate via contiguous frame count.
+            return Ok(ActuatorFrame {
+                target_time_ns: sensors.target_time_ns,
+                motors: frame.motors,
+                diagnostics: frame,
+            });
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::benchmark::{GnssObservation, SimulatorState};
+    fn packet(count: u32, pwm: [u16; 4]) -> Vec<u8> {
+        let mut bytes = vec![0; 40];
+        bytes[..2].copy_from_slice(&18458u16.to_le_bytes());
+        bytes[2..4].copy_from_slice(&RATE_HZ.to_le_bytes());
+        bytes[4..8].copy_from_slice(&count.to_le_bytes());
+        for (i, x) in pwm.iter().enumerate() {
+            bytes[8 + 2 * i..10 + 2 * i].copy_from_slice(&x.to_le_bytes());
+        }
+        bytes
+    }
+    fn input() -> (SensorFrame, PilotCommand) {
+        let sensors = SensorFrame {
+            target_time_ns: 625_000,
+            gyro_flu_rad_s: [1., 2., 3.],
+            specific_force_flu_m_s2: [0., 0., 9.80665],
+            gnss: GnssObservation::default(),
+            simulator_state: Some(SimulatorState {
+                position_enu_m: [1., 2., 3.],
+                velocity_enu_m_s: [4., 5., 6.],
+                euler_flu_enu_rad: [0.2, 0.3, 0.],
+            }),
+        };
+        let mut channels_us = [1500; 16];
+        channels_us[2] = 1000;
+        channels_us[4] = 1000;
+        (
+            sensors,
+            PilotCommand {
+                channels_us,
+                square_plan: None,
+            },
+        )
+    }
+    #[test]
+    fn axes_and_gravity_are_converted_to_ned_frd() {
+        let (s, c) = input();
+        let b = encode(&s, &c).unwrap();
+        assert_eq!(b[0], b'\n');
+        assert_eq!(*b.last().unwrap(), b'\n');
+        let j: serde_json::Value = serde_json::from_slice(&b).unwrap();
+        assert_eq!(j["position"], serde_json::json!([2., 1., -3.]));
+        assert_eq!(j["velocity"], serde_json::json!([5., 4., -6.]));
+        assert_eq!(j["imu"]["gyro"], serde_json::json!([1., -2., -3.]));
+        assert!(j["imu"]["accel_body"][2].as_f64().unwrap() < -9.8);
+        assert_eq!(
+            j["attitude"],
+            serde_json::json!([0.2, -0.3, std::f64::consts::FRAC_PI_2])
+        );
+    }
+    #[test]
+    fn servo_order_lengths_and_limits_are_checked() {
+        assert_eq!(
+            decode(&packet(1, [1100, 1200, 1300, 1400])).unwrap().motors,
+            [0.1, 0.4, 0.2, 0.3]
+        );
+        assert!(decode(&packet(0, [999, 0, 0, 0])).is_err());
+        assert!(decode(&[0; 40]).is_err());
+        assert!(decode(&packet(0, [0; 4])[..39]).is_err());
+        let mut b = packet(0, [0; 4]);
+        b[..2].copy_from_slice(&29569u16.to_le_bytes());
+        b.resize(72, 0);
+        assert!(decode(&b).is_ok());
+        b[2..4].copy_from_slice(&0u16.to_le_bytes());
+        assert!(decode(&b).is_err());
+    }
+    #[test]
+    fn armed_or_nonfinite_inputs_are_rejected() {
+        let (mut s, mut c) = input();
+        c.channels_us[4] = 2000;
+        assert!(encode(&s, &c).is_err());
+        c.channels_us[4] = 1000;
+        s.simulator_state.as_mut().unwrap().position_enu_m[0] = f64::NAN;
+        assert!(encode(&s, &c).is_err());
+    }
+    #[test]
+    fn response_rate_change_is_rejected_after_bootstrap() {
+        let mut adapter = ArduPilotAdapter::bind().unwrap();
+        let address = adapter.address().unwrap();
+        let peer = std::thread::spawn(move || {
+            let socket = UdpSocket::bind("127.0.0.1:0").unwrap();
+            socket
+                .set_read_timeout(Some(Duration::from_secs(2)))
+                .unwrap();
+            socket.send_to(&packet(0, [0; 4]), address).unwrap();
+            socket.recv_from(&mut [0; 4096]).unwrap();
+            let mut reply = packet(1, [1000; 4]);
+            reply[2..4].copy_from_slice(&800u16.to_le_bytes());
+            socket.send_to(&reply, address).unwrap();
+        });
+        let (sensors, command) = input();
+        let error = adapter
+            .step(&sensors, &command, Duration::from_secs(2))
+            .err()
+            .unwrap();
+        assert!(error.to_string().contains("clock negotiation"));
+        assert_eq!(adapter.last_time_ns, 0);
+        peer.join().unwrap();
+    }
+
+    #[test]
+    fn missing_peer_expires_without_advancing_adapter_time() {
+        let mut adapter = ArduPilotAdapter::bind().unwrap();
+        let (sensors, command) = input();
+        assert!(
+            adapter
+                .step(&sensors, &command, Duration::from_millis(10))
+                .is_err()
+        );
+        assert_eq!(adapter.last_time_ns, 0);
+        assert!(adapter.last_frame.is_none());
+    }
+
+    #[test]
+    fn udp_handshake_ignores_duplicates_and_rejects_frame_gaps() {
+        let mut adapter = ArduPilotAdapter::bind().unwrap();
+        let address = adapter.address().unwrap();
+        let server = std::thread::spawn(move || {
+            let socket = UdpSocket::bind("127.0.0.1:0").unwrap();
+            socket
+                .set_read_timeout(Some(Duration::from_secs(2)))
+                .unwrap();
+            let mut bootstrap = packet(0, [0; 4]);
+            bootstrap[2..4].copy_from_slice(&1200u16.to_le_bytes());
+            socket.send_to(&bootstrap, address).unwrap();
+            let mut bytes = [0; 4096];
+            socket.recv_from(&mut bytes).unwrap();
+            socket.send_to(&packet(0, [0; 4]), address).unwrap();
+            socket.send_to(&packet(1, [1000; 4]), address).unwrap();
+            socket.recv_from(&mut bytes).unwrap();
+            socket.send_to(&packet(3, [1000; 4]), address).unwrap();
+        });
+        let (mut sensors, command) = input();
+        let out = adapter
+            .step(&sensors, &command, Duration::from_secs(2))
+            .unwrap();
+        assert_eq!(out.diagnostics.frame_count, 1);
+        assert_eq!(adapter.duplicates_ignored, 1);
+        sensors.target_time_ns += 625_000;
+        assert!(
+            adapter
+                .step(&sensors, &command, Duration::from_secs(2))
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("gap/reset")
+        );
+        server.join().unwrap();
+    }
+}
diff --git a/xtask/src/ardupilot_probe.rs b/xtask/src/ardupilot_probe.rs
new file mode 100644
index 0000000..9ce576d
--- /dev/null
+++ b/xtask/src/ardupilot_probe.rs
@@ -0,0 +1,254 @@
+//! Bounded, disarmed real-ArduPilot connection test against the shared FMI plant.
+use std::ffi::OsString;
+use std::fs::{self, File};
+use std::io::{BufWriter, Write};
+use std::path::PathBuf;
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use anyhow::{Context, Result, bail};
+use serde::Serialize;
+
+use crate::ardupilot::{ArduPilotAdapter, REVISION};
+use crate::benchmark::{
+    self, ExchangeMetrics, PilotCommand, SensorFrame, SimulatorState, SyntheticGnss,
+};
+use crate::physics::Plant;
+
+const STEP_NS: u64 = 625_000;
+const STEPS: u64 = 8000;
+
+struct ChildGuard(Child);
+impl Drop for ChildGuard {
+    fn drop(&mut self) {
+        let _ = self.0.kill();
+        let _ = self.0.wait();
+    }
+}
+
+#[derive(Default, Serialize)]
+struct ProbeReport {
+    passed: bool,
+    qualification: String,
+    expected_ardupilot_revision: String,
+    executable_sha256: String,
+    plant_sha256: String,
+    description_sha256: String,
+    plant_library: String,
+    plant_description: String,
+    steps: u64,
+    simulated_seconds: f64,
+    first_frame: Option<u32>,
+    last_frame: Option<u32>,
+    duplicates_ignored: u64,
+    motor_actuation_observed: bool,
+    exchange_metrics: ExchangeMetrics,
+    error: Option<String>,
+}
+
+pub fn run(args: impl IntoIterator<Item = OsString>) -> Result<()> {
+    let mut executable = None;
+    let mut library = None;
+    let mut description = None;
+    let mut plant_directory = None;
+    let mut output = PathBuf::from("artifacts/ardupilot-probe");
+    let mut args = args.into_iter();
+    while let Some(arg) = args.next() {
+        let name = arg.to_str().context("argument must be UTF-8")?;
+        if name == "--help" {
+            println!(
+                "cargo xtask ardupilot-probe --executable PATH (--plant-directory PATH | --plant-library PATH --plant-description PATH) [--output DIRECTORY]\nRuns 5 simulated seconds, disarmed, with a new result directory per run."
+            );
+            return Ok(());
+        }
+        let value = args
+            .next()
+            .with_context(|| format!("{name} requires a value"))?;
+        match name {
+            "--executable" => executable = Some(PathBuf::from(value)),
+            "--plant-library" => library = Some(PathBuf::from(value)),
+            "--plant-description" => description = Some(PathBuf::from(value)),
+            "--plant-directory" => plant_directory = Some(PathBuf::from(value)),
+            "--output" => output = PathBuf::from(value),
+            _ => bail!("unknown probe argument {name}"),
+        }
+    }
+    let executable = executable
+        .context("--executable is required")?
+        .canonicalize()?;
+    if let Some(directory) = plant_directory {
+        if library.is_some() || description.is_some() {
+            bail!("--plant-directory cannot be combined with explicit library/description paths");
+        }
+        if std::env::consts::OS != "linux" {
+            bail!("ArduPilot probe currently supports Linux hosts only");
+        }
+        let xml_path = directory.join("modelDescription.xml");
+        let xml = fs::read_to_string(&xml_path)?;
+        let doc = roxmltree::Document::parse(&xml)?;
+        let id = doc
+            .descendants()
+            .find(|n| n.has_tag_name("CoSimulation"))
+            .and_then(|n| n.attribute("modelIdentifier"))
+            .context("FMI CoSimulation model identifier missing")?;
+        if id.is_empty() || !id.chars().all(|c| c.is_ascii_alphanumeric() || c == '_') {
+            bail!("invalid FMI model identifier");
+        }
+        library = Some(
+            directory
+                .join("binaries")
+                .join(format!("{}-linux", std::env::consts::ARCH))
+                .join(format!("{id}.so")),
+        );
+        description = Some(xml_path);
+    }
+    let library = library
+        .context("--plant-library is required")?
+        .canonicalize()?;
+    let description = description
+        .context("--plant-description is required")?
+        .canonicalize()?;
+    let mut plant = Plant::open(&library, &description)?;
+    let mut adapter = ArduPilotAdapter::bind()?;
+    let port = adapter.address()?.port();
+    fs::create_dir_all(&output)?;
+    let run_directory = output.canonicalize()?.join(format!(
+        "run-{}-{}",
+        SystemTime::now().duration_since(UNIX_EPOCH)?.as_nanos(),
+        std::process::id()
+    ));
+    fs::create_dir(&run_directory)?;
+    let defaults = run_directory.join("probe.parm");
+    fs::write(
+        &defaults,
+        include_str!("../missions/ardupilot-json-probe.parm"),
+    )?;
+    let log = File::create(run_directory.join("ardupilot.log"))?;
+    let child = Command::new(&executable)
+        .current_dir(&run_directory)
+        .args([
+            "--model",
+            "JSON:127.0.0.1",
+            "--home",
+            "40.4237,-86.9212,200,90",
+            "--speedup",
+            "5",
+            "--sim-port-out",
+        ])
+        .arg(port.to_string())
+        .args(["--serial0", "udpclient:127.0.0.1:14650", "--defaults"])
+        .arg(&defaults)
+        .stdin(Stdio::null())
+        .stdout(log.try_clone()?)
+        .stderr(log)
+        .spawn()
+        .with_context(|| format!("launch ArduPilot {}", executable.display()))?;
+    let _child = ChildGuard(child);
+    let mut report = ProbeReport {
+        qualification: "transport-only; no flight or shared-sensor-parity claim".into(),
+        expected_ardupilot_revision: REVISION.into(),
+        executable_sha256: sha256(&executable)?,
+        plant_sha256: sha256(&library)?,
+        description_sha256: sha256(&description)?,
+        plant_library: library.display().to_string(),
+        plant_description: description.display().to_string(),
+        ..ProbeReport::default()
+    };
+    let mut trajectory =
+        BufWriter::new(File::create(run_directory.join("mission-trajectory.csv"))?);
+    writeln!(trajectory, "time_s,x_m,y_m,z_m,roll_rad,pitch_rad,yaw_rad")?;
+    let result = (|| -> Result<()> {
+        let mut gnss = SyntheticGnss::default();
+        let mut channels_us = [1500; 16];
+        channels_us[2] = 1000;
+        channels_us[4] = 1000;
+        let command = PilotCommand {
+            channels_us,
+            square_plan: None,
+        };
+        for step in 1..=STEPS {
+            let target_time_ns = step * STEP_NS;
+            let (gyro, accel) = plant.imu_flu();
+            let sensors = SensorFrame {
+                target_time_ns,
+                gyro_flu_rad_s: gyro,
+                specific_force_flu_m_s2: accel,
+                gnss: gnss.sample(plant.position(), plant.velocity(), target_time_ns),
+                simulator_state: Some(SimulatorState {
+                    position_enu_m: plant.position(),
+                    velocity_enu_m_s: plant.velocity(),
+                    euler_flu_enu_rad: plant.euler(),
+                }),
+            };
+            let timeout = Duration::from_secs(if step == 1 { 30 } else { 2 });
+            let (response, elapsed) =
+                benchmark::exchange(&mut adapter, &sensors, &command, timeout)?;
+            if response.motors.iter().any(|&x| x != 0.) {
+                report.motor_actuation_observed = true;
+                bail!("unexpected motor actuation during disarmed probe");
+            }
+            benchmark::commit(&mut plant, &response, 0.000625)?;
+            let p = plant.position();
+            let e = plant.euler();
+            if !p.iter().chain(e.iter()).all(|x| x.is_finite()) {
+                bail!("nonfinite plant state");
+            }
+            writeln!(
+                trajectory,
+                "{:.9},{:.9},{:.9},{:.9},{:.9},{:.9},{:.9}",
+                target_time_ns as f64 * 1e-9,
+                p[0],
+                p[1],
+                p[2],
+                e[0],
+                e[1],
+                e[2]
+            )?;
+            report
+                .first_frame
+                .get_or_insert(response.diagnostics.frame_count);
+            report.last_frame = Some(response.diagnostics.frame_count);
+            report
+                .exchange_metrics
+                .record(elapsed, response.motors, false);
+            report.steps = step;
+        }
+        Ok(())
+    })();
+    trajectory.flush()?;
+    report.duplicates_ignored = adapter.duplicates_ignored;
+    report.simulated_seconds = report.steps as f64 * 0.000625;
+    report.exchange_metrics.finish();
+    report.passed = result.is_ok() && report.steps == STEPS;
+    report.error = result.as_ref().err().map(|e| format!("{e:#}"));
+    fs::write(
+        run_directory.join("report.json"),
+        serde_json::to_vec_pretty(&report)?,
+    )?;
+    println!(
+        "ARDUPILOT_PROBE passed={} steps={} report={}",
+        report.passed,
+        report.steps,
+        run_directory.join("report.json").display()
+    );
+    result
+}
+
+fn sha256(path: &std::path::Path) -> Result<String> {
+    let output = Command::new("sha256sum")
+        .arg(path)
+        .output()
+        .context("sha256sum is required for probe provenance")?;
+    if !output.status.success() {
+        bail!("cannot hash {}", path.display());
+    }
+    let value = String::from_utf8(output.stdout)?
+        .split_whitespace()
+        .next()
+        .context("missing hash")?
+        .to_owned();
+    if value.len() != 64 || !value.chars().all(|x| x.is_ascii_hexdigit()) {
+        bail!("invalid SHA-256 output");
+    }
+    Ok(value)
+}
