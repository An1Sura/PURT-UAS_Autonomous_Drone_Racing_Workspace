+//! CogniPilot wire-format conversion; no physics or sensor scheduling here.
+use crate::benchmark::{ActuatorFrame, FlightStackAdapter, PilotCommand, SensorFrame};
+use crate::{protocol, shared_memory::LockstepOutputs};
+use anyhow::{Result, bail};
+use std::time::Duration;
+
+pub struct CogniPilotAdapter<F> {
+    pub exchange: F,
+    pub origin_enu_m: Option<[f64; 3]>,
+}
+
+impl<F> FlightStackAdapter for CogniPilotAdapter<F>
+where
+    F: FnMut(&protocol::LockstepInputs, Duration) -> Result<LockstepOutputs>,
+{
+    type Diagnostics = LockstepOutputs;
+    fn step(
+        &mut self,
+        sensors: &SensorFrame,
+        command: &PilotCommand,
+        timeout: Duration,
+    ) -> Result<ActuatorFrame<Self::Diagnostics>> {
+        let plan = match command.square_plan {
+            Some(plan) => {
+                protocol::bounded_square_plan(plan.sequence, plan.side_m, plan.speed_m_s)?
+            }
+            None => protocol::WaypointPlanWire::default(),
+        };
+        if command.square_plan.is_some() && command.reference.is_some() {
+            bail!("cannot mix internal planner and external reference");
+        }
+        let mut inputs = protocol::lockstep_inputs(
+            sensors.gyro_flu_rad_s,
+            sensors.specific_force_flu_m_s2,
+            command.channels_us,
+            protocol::gnss_fix(sensors.gnss),
+            plan,
+            sensors.target_time_ns,
+        );
+        if let Some((timestamp, reference)) = command.reference {
+            inputs.external_reference = reference_wire(
+                timestamp,
+                sensors.target_time_ns,
+                to_local(
+                    reference,
+                    self.origin_enu_m
+                        .ok_or_else(|| anyhow::anyhow!("firmware navigation origin unavailable"))?,
+                ),
+            )?;
+        }
+        let output = (self.exchange)(&inputs, timeout)?;
+        if let Some(lla) = output.navigation_origin_lla {
+            self.origin_enu_m = Some(origin_enu(lla));
+        }
+        Ok(ActuatorFrame {
+            target_time_ns: output.mission_status.timestamp_ns,
+            motors: output.motor_command.values,
+            diagnostics: output,
+        })
+    }
+}
+
+pub fn reference_wire(
+    timestamp: u64,
+    now: u64,
+    r: crate::reference::Reference,
+) -> Result<synapse_fbs::topic::LocalPositionCommandData> {
+    use synapse_fbs::{
+        topic::LocalPositionCommandData,
+        types::{LocalFrame, TimeStatus, Vec3f},
+    };
+    if timestamp == 0 || timestamp > now || now - timestamp > 100_000_000 {
+        bail!("external reference timestamp is not current");
+    }
+    if !r
+        .position_enu_m
+        .iter()
+        .chain(r.velocity_enu_m_s.iter())
+        .chain(std::iter::once(&r.yaw_enu_rad))
+        .all(|x| x.is_finite() && x.abs() < 10000.)
+    {
+        bail!("invalid external reference values");
+    }
+    Ok(LocalPositionCommandData::new(
+        timestamp,
+        &Vec3f::new(
+            r.position_enu_m[0] as f32,
+            r.position_enu_m[1] as f32,
+            r.position_enu_m[2] as f32,
+        ),
+        &Vec3f::new(
+            r.velocity_enu_m_s[0] as f32,
+            r.velocity_enu_m_s[1] as f32,
+            r.velocity_enu_m_s[2] as f32,
+        ),
+        &Vec3f::new(0., 0., 0.),
+        r.yaw_enu_rad as f32,
+        0.,
+        0,
+        LocalFrame::LocalEnu,
+        TimeStatus::LocalFreerun,
+    ))
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn reference_preserves_enu_and_rejects_bad_inputs() {
+        let r = crate::reference::Reference {
+            position_enu_m: [1., 2., 3.],
+            velocity_enu_m_s: [4., 5., 6.],
+            yaw_enu_rad: 0.2,
+        };
+        let wire = reference_wire(1, 1, r).unwrap();
+        assert_eq!(wire.position_enu_m().x(), 1.);
+        assert_eq!(wire.position_enu_m().y(), 2.);
+        assert_eq!(wire.velocity_enu_m_s().z(), 6.);
+        assert!(reference_wire(2, 1, r).is_err());
+        assert!(reference_wire(1, 100_000_002, r).is_err());
+        let mut invalid = r;
+        invalid.yaw_enu_rad = f64::NAN;
+        assert!(reference_wire(1, 1, invalid).is_err());
+    }
+}
+
+#[cfg(test)]
+mod firmware_tests {
+    use super::*;
+    use crate::{benchmark::SyntheticGnss, protocol, shared_memory::Transport};
+    use std::{
+        env, fs,
+        process::{Child, Command, Stdio},
+    };
+    struct Firmware(Child);
+    impl Drop for Firmware {
+        fn drop(&mut self) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+    #[test]
+    #[ignore = "requires rebuilt native firmware: RDD2_NATIVE_SIM_EXECUTABLE"]
+    fn native_reference_echo_and_invalid_ingress_rejection() -> Result<()> {
+        let executable = env::var_os("RDD2_NATIVE_SIM_EXECUTABLE")
+            .ok_or_else(|| anyhow::anyhow!("missing native firmware executable"))?;
+        for case in 0..4 {
+            let path = env::temp_dir().join(format!(
+                "rdd2-reference-test-{}-{case}.bin",
+                std::process::id()
+            ));
+            let mut transport = Transport::create_direct(&path)?;
+            let _child = Firmware(
+                Command::new(&executable)
+                    .env("RDD2_LOCKSTEP_SHM", &path)
+                    .stdout(Stdio::null())
+                    .stderr(Stdio::null())
+                    .spawn()?,
+            );
+            let result = (|| -> Result<()> {
+                let mut gnss = SyntheticGnss::default();
+                let mut channels = [1500; 16];
+                channels[2] = 1000;
+                channels[4] = 1000;
+                channels[5] = 1000;
+                let mut time = 0u64;
+                for _ in 0..3200 {
+                    time += 625_000;
+                    let input = protocol::lockstep_inputs(
+                        [0.; 3],
+                        [0., 0., 9.80665],
+                        channels,
+                        protocol::gnss_fix(gnss.sample([0., 0., 0.1], [0.; 3], time)),
+                        protocol::WaypointPlanWire::default(),
+                        time,
+                    );
+                    transport.exchange(&input, Duration::from_secs(5))?;
+                }
+                let reference =
+                    reference_wire(time + 625_000, time + 625_000, crate::reference::sample(2.))?;
+                let mut echoed = false;
+                for _ in 0..32 {
+                    time += 625_000;
+                    let mut input = protocol::lockstep_inputs(
+                        [0.; 3],
+                        [0., 0., 9.80665],
+                        channels,
+                        protocol::gnss_fix(gnss.sample([0., 0., 0.1], [0.; 3], time)),
+                        protocol::WaypointPlanWire::default(),
+                        time,
+                    );
+                    input.external_reference = reference;
+                    let output = transport.exchange(&input, Duration::from_secs(2))?;
+                    echoed |= output.planner_reference == reference;
+                }
+                if !echoed {
+                    bail!("valid external reference was not echoed");
+                }
+                time += 625_000;
+                let mut input = protocol::lockstep_inputs(
+                    [0.; 3],
+                    [0., 0., 9.80665],
+                    channels,
+                    protocol::gnss_fix(gnss.sample([0., 0., 0.1], [0.; 3], time)),
+                    protocol::WaypointPlanWire::default(),
+                    time,
+                );
+                input.external_reference = reference;
+                match case {
+                    0 => input.external_reference.set_timestamp_ns(time + 1),
+                    1 => input
+                        .external_reference
+                        .set_timestamp_ns(time - 100_000_001),
+                    2 => {
+                        input.external_reference.set_timestamp_ns(time);
+                        input.external_reference.set_yaw_rad(f32::NAN);
+                    }
+                    _ => input.waypoint_plan = protocol::bounded_square_plan(1, 0.5, 0.1)?,
+                }
+                if transport
+                    .exchange(&input, Duration::from_millis(250))
+                    .is_ok()
+                {
+                    bail!("invalid external reference case {case} accepted");
+                }
+                Ok(())
+            })();
+            drop(_child);
+            let _ = fs::remove_file(path);
+            result?;
+        }
+        Ok(())
+    }
+}
+
+/// Convert the reported geodetic origin into the benchmark ENU datum.
+pub fn origin_enu(lla: [i32; 3]) -> [f64; 3] {
+    use crate::benchmark::{
+        GNSS_ORIGIN_ALTITUDE_MSL_M, GNSS_ORIGIN_LATITUDE_DEG, GNSS_ORIGIN_LONGITUDE_DEG,
+    };
+    let north = (lla[0] as f64 * 1e-7 - GNSS_ORIGIN_LATITUDE_DEG).to_radians() * 6_378_137.;
+    let east = (lla[1] as f64 * 1e-7 - GNSS_ORIGIN_LONGITUDE_DEG).to_radians()
+        * 6_378_137.
+        * GNSS_ORIGIN_LATITUDE_DEG.to_radians().cos();
+    [
+        east,
+        north,
+        lla[2] as f64 * 1e-3 - GNSS_ORIGIN_ALTITUDE_MSL_M,
+    ]
+}
+pub fn to_local(
+    mut reference: crate::reference::Reference,
+    origin: [f64; 3],
+) -> crate::reference::Reference {
+    for i in 0..3 {
+        reference.position_enu_m[i] -= origin[i];
+    }
+    reference
+}
+
+#[cfg(test)]
+mod origin_tests {
+    use super::*;
+    #[test]
+    fn origin_translation_preserves_physical_height_and_velocity() {
+        let origin = origin_enu([404237000, -869212000, 200098]);
+        assert!(origin[0].abs() < 1e-8 && origin[1].abs() < 1e-8);
+        assert!((origin[2] - 0.098).abs() < 1e-8);
+        let canonical = crate::reference::sample(2.);
+        let local = to_local(canonical, origin);
+        assert!((local.position_enu_m[2] - 1.402).abs() < 1e-8);
+        assert_eq!(local.velocity_enu_m_s, canonical.velocity_enu_m_s);
+        for axis in 0..3 {
+            assert!(
+                (local.position_enu_m[axis] + origin[axis] - canonical.position_enu_m[axis]).abs()
+                    < 1e-12
+            );
+        }
+    }
+}
